<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerDesktop"
             xmlns:views="using:MessengerDesktop.Views"
             xmlns:conv="using:MessengerDesktop"
             x:Class="MessengerDesktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Palette.axaml"/>
        <ResourceInclude Source="/Styles/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    <conv:InverseBoolConverter x:Key="Not"/>
    <conv:EqConverter x:Key="Eq"/>
    <conv:MineAlignConverter x:Key="Align"/>
    <conv:AvatarBrushConverter x:Key="AvatarBrush"/>
    <conv:InitialConverter x:Key="Initial"/>
  </ResourceDictionary>
  </Application.Resources>
  <Application.DataTemplates>
    <DataTemplate DataType="vm:LoginViewModel">
      <views:LoginView/>
    </DataTemplate>
    <DataTemplate DataType="vm:ShellViewModel">
      <views:ShellView/>
    </DataTemplate>
  </Application.DataTemplates>
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml"/>
    <StyleInclude Source="avares://MessengerDesktop/Styles/Theme.axaml"/>
  </Application.Styles>
</Application>
