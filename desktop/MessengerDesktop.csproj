<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MessengerDesktop</RootNamespace>
    <AssemblyName>MessengerDesktop</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../backend/Infrastructure/EntityIds.cs" Link="EntityIds.cs" />
    <Compile Include="../backend/Infrastructure/ServerIdentityProof.cs" Link="ServerIdentityProof.cs" />
    <InternalsVisibleTo Include="AntispamChecks" />
    <InternalsVisibleTo Include="ServerIdentityChecks" />
    <Content Include="Antispam\LICENSE-three.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Antispam\NOTICE-media.txt" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\Wallpapers\*.svg" />
    <Content Include="Assets\Wallpapers\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\LUCIDE-LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\Twemoji\*.png" />
    <Content Include="Assets\Twemoji\LICENSE-GRAPHICS" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Twemoji\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.11" />
    <PackageReference Include="Avalonia" Version="11.2.1" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.2.1" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

</Project>
