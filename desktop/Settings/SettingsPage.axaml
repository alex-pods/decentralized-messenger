<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Settings.SettingsPage">
  <DockPanel>
    <TextBlock x:Name="SaveStatus" DockPanel.Dock="Bottom" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}"
               IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
    <ScrollViewer x:Name="SettingsScroll" Classes="dialogScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False" ClipToBounds="True">
      <StackPanel Spacing="14" Margin="0,0,0,12">
        <Button x:Name="Appearance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,8">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <local:Glyph Data="{StaticResource IcPalette}" Margin="0,0,12,0"/>
            <TextBlock Grid.Column="1" Text="Оформление" FontWeight="Medium" VerticalAlignment="Center"/>
            <local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16" Margin="8,0,0,0"/>
          </Grid>
        </Button>
        <Border Height="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel x:Name="PrivacySection" Spacing="10">
          <TextBlock Text="Приватность" FontSize="15" FontWeight="SemiBold"/>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Margin="0,0,8,0" Spacing="4">
              <TextBlock Text="Поиск по тегу для незнакомых" TextWrapping="Wrap"/>
              <TextBlock Text="Люди из личных переписок и общих групп всё равно смогут найти вас." Classes="caption" TextWrapping="Wrap"/>
            </StackPanel>
            <ToggleSwitch Grid.Column="1" x:Name="TagSearch" OnContent="" OffContent=""
                          VerticalAlignment="Center" AutomationProperties.Name="Поиск по тегу для незнакомых"/>
          </Grid>
          <TextBlock x:Name="PrivacyStatus" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel x:Name="MessagesSection" Spacing="10">
          <TextBlock Text="Отправка сообщения" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="Клавиши и двойной клик настраиваются только на этом устройстве." Classes="caption" TextWrapping="Wrap"/>
          <RadioButton x:Name="SendEnter" GroupName="send" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="3"><TextBlock Text="Enter" FontWeight="Medium"/><TextBlock Text="Shift + Enter — новая строка" Classes="caption" TextWrapping="Wrap"/></StackPanel>
          </RadioButton>
          <RadioButton x:Name="SendControlEnter" GroupName="send" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="3"><TextBlock x:Name="ControlEnterLabel" FontWeight="Medium"/><TextBlock Text="Enter — новая строка" Classes="caption"/></StackPanel>
          </RadioButton>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource LineBrush}"/>
        <StackPanel Spacing="10">
          <TextBlock Text="Двойной клик по сообщению" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <RadioButton x:Name="DoubleReply" GroupName="double" Content="Ответить"/>
          <RadioButton x:Name="DoubleReact" GroupName="double" Content="Поставить реакцию"/>
          <RadioButton x:Name="DoubleNone" GroupName="double" Content="Ничего не делать"/>
          <Expander x:Name="ReactionChoices" HorizontalAlignment="Stretch" Padding="7,5">
            <Expander.Header>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <local:ReactionIcon x:Name="CurrentReaction" Width="20" Height="20"/>
                <TextBlock Text="Изменить реакцию" VerticalAlignment="Center"/>
              </StackPanel>
            </Expander.Header>
            <local:ReactionPicker x:Name="Reactions" MaxWidth="264" HorizontalAlignment="Left"/>
          </Expander>
        </StackPanel>
        <Border Height="1" Background="{DynamicResource LineBrush}"/>
        <Expander Header="Сервер" HorizontalAlignment="Stretch">
          <SelectableTextBlock Text="{Binding ServerLabel}" Classes="caption" Margin="8,4" TextWrapping="Wrap"/>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
