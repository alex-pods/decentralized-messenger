<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MessengerDesktop">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ChassisBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption, TextBlock.engraved">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.avatarText">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="local|Glyph">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style Selector="Border.screen, Border.deck">
    <Setter Property="Background" Value="{DynamicResource ChassisBrush}"/>
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="CornerRadius" Value="24"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.avatar.groupAvatar">
    <Setter Property="CornerRadius" Value="10"/>
  </Style>
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="{DynamicResource BubbleTheirs}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BubbleTheirsEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="5,10,10,10"/>
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="CornerRadius" Value="10,5,10,10"/>
    <Setter Property="Background" Value="{DynamicResource BubbleMine}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BubbleMineEdge}"/>
  </Style>
  <Style Selector="Border.historyLabel">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.messageAvatar">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.replyCard">
    <Setter Property="Background" Value="{DynamicResource QuoteFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Border.composeContext">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="7"/>
    <Setter Property="Padding" Value="9,1,3,1"/>
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.scrim">
    <Setter Property="Background" Value="{DynamicResource DimBrush}"/>
  </Style>
  <Style Selector="Border.glass, Border.capsule, Border.toast">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Border.reaction, Border.chip">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>
  <Style Selector="Border.reaction.active">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.unread">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionFill}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value=".45"/>
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Button.small, Button.toolbar">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.primary, Button.send">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
  </Style>
  <Style Selector="TextBox.authInput:not(:focus)">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource InputOutlineBrush}"/>
  </Style>
  <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="TextBox:not(:disabled) /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Expander">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="CornerRadius" Value="8"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
  </Style>
  <Style Selector="Button.secondaryAction">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.themePreset, Button.themeAccent">
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.themePreset.active, Button.themeAccent.active">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.themeAccent local|Glyph.swatchCheck">
    <Setter Property="IsVisible" Value="False"/>
  </Style>
  <Style Selector="Button.themeAccent.active local|Glyph.swatchCheck">
    <Setter Property="IsVisible" Value="True"/>
  </Style>
  <Style Selector="Button.themeCommit">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource RaisedBrush}"/>
  </Style>
  <Style Selector="Button.themeCommit:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="Opacity" Value=".85"/>
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="8,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="8,5"/>
    <Setter Property="Margin" Value="8,1"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem, ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.recipient ListBoxItem">
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.recipient ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="local|Glyph.recipientCheck">
    <Setter Property="Opacity" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:selected local|Glyph.recipientCheck">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.forwardAction:disabled">
    <Setter Property="Opacity" Value="1"/>
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="Button.forwardAction:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>

  <Style Selector="Button.messageMenu">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/>
    <Setter Property="MinHeight" Value="30"/><Setter Property="Padding" Value="6"/>
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Grid.Column" Value="3"/>
    <Setter Property="Margin" Value="6,0,0,0"/>
  </Style>
  <Style Selector="Button.messageMenu.ownActions">
    <Setter Property="Grid.Column" Value="1"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
  <Style Selector="Grid.messageRow:pointerover Button.messageMenu, Button.messageMenu:focus-visible">
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.reaction">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="7,4"/>
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.reaction.active, Button.reactionChoice.chosen">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.reactionChoice">
    <Setter Property="Width" Value="40"/><Setter Property="Height" Value="40"/>
    <Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,4,4"/>
    <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.account"><Setter Property="Padding" Value="10"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style Selector="Button.profileRow">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Padding" Value="8,9"/>
  </Style>
  <Style Selector="Button.primary, Button.send"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="{DynamicResource ActionTextBrush}"/><Setter Property="Opacity" Value=".85"/></Style>
  <Style Selector="Button.send:disabled">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    <Setter Property="Opacity" Value="1"/>
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="MenuItem"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="13"/></Style>
  <Style Selector="MenuItem.danger"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/></Style>
  <Style Selector="Border.badge"><Setter Property="Padding" Value="6,2"/><Setter Property="CornerRadius" Value="4"/><Setter Property="Background" Value="{DynamicResource HoverFill}"/></Style>
  <Style Selector="Border.badge TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/></Style>
  <Style Selector="TextBox.search">
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,0"/>
  </Style>

  <Style Selector="TextBlock.deleted"><Setter Property="FontStyle" Value="Italic"/><Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/></Style>
</Styles>
