<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MessengerDesktop">
  <!-- Корпус прибора: холодный серый металл, утопленный тёмный экран, выпуклые клавиши, оранжевые лампы. -->
  <Styles.Resources>
    <ResourceDictionary>
      <x:Double x:Key="ControlContentThemeFontSize">17</x:Double>
      <Thickness x:Key="ChromeLeading">12,0,12,0</Thickness>
      <Thickness x:Key="HeaderInset">0</Thickness>
      <Thickness x:Key="LoginMargin">28,22,28,22</Thickness>
      <Thickness x:Key="ScrewInset">8</Thickness>

      <FontFamily x:Key="IndustrialHost">avares://MessengerDesktop/Assets/Fonts#Host Grotesk, Inter</FontFamily>
      <FontFamily x:Key="IndustrialPlex">avares://MessengerDesktop/Assets/Fonts#IBM Plex Mono</FontFamily>

      <Color x:Key="Chassis">#CBD0D2</Color>
      <Color x:Key="Raised">#E7EAEB</Color>
      <Color x:Key="Well">#B6BEC2</Color>
      <Color x:Key="Ink">#181E22</Color>
      <Color x:Key="Label">#414B52</Color>
      <Color x:Key="Field">#20272B</Color>
      <Color x:Key="OnField">#F2F4F4</Color>
      <Color x:Key="OnFieldMuted">#D8DEE1</Color>
      <Color x:Key="Accent">#F15B22</Color>

      <SolidColorBrush x:Key="ChassisBrush" Color="{StaticResource Chassis}"/>
      <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="WellBrush" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
      <SolidColorBrush x:Key="LabelBrush" Color="{StaticResource Label}"/>
      <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource Field}"/>
      <SolidColorBrush x:Key="OnFieldBrush" Color="{StaticResource OnField}"/>
      <SolidColorBrush x:Key="OnFieldMutedBrush" Color="{StaticResource OnFieldMuted}"/>
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>

      <!-- Прежние имена, чтобы вью не потеряли кисти -->
      <SolidColorBrush x:Key="MainFill" Color="{StaticResource Chassis}"/>
      <SolidColorBrush x:Key="SidebarFill" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="ElevatedFill" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="HoverFill" Color="#F4F6F6"/>
      <SolidColorBrush x:Key="LineBrush" Color="#8E989E"/>
      <SolidColorBrush x:Key="LabelPrimary" Color="{StaticResource Ink}"/>
      <SolidColorBrush x:Key="LabelSecondary" Color="{StaticResource Label}"/>
      <SolidColorBrush x:Key="LabelTertiary" Color="{StaticResource Label}"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#9E2B2B"/>
      <SolidColorBrush x:Key="OnlineBrush" Color="{StaticResource Accent}"/>
      <SolidColorBrush x:Key="SeparatorBrush" Color="#9AA3A8"/>
      <SolidColorBrush x:Key="PanelFill" Color="{StaticResource Chassis}"/>
      <SolidColorBrush x:Key="GlassFill" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="GlassFillHover" Color="#F4F6F6"/>
      <SolidColorBrush x:Key="GlassFillPressed" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="RowHover" Color="{StaticResource Chassis}"/>
      <SolidColorBrush x:Key="SheetFill" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="ToastFill" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="FieldFill" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="FieldFillHover" Color="#C5CCCF"/>
      <SolidColorBrush x:Key="FieldBorder" Color="#8E989E"/>
      <SolidColorBrush x:Key="DimBrush" Color="#B3181E22"/>
      <SolidColorBrush x:Key="BubbleTheirs" Color="Transparent"/>
      <SolidColorBrush x:Key="BubbleMine" Color="#2C353A"/>
      <SolidColorBrush x:Key="ScreenInset" Color="#1A2124"/>
      <SolidColorBrush x:Key="GlassEdge" Color="#8E989E"/>
      <SolidColorBrush x:Key="PanelEdge" Color="#8E989E"/>
      <SolidColorBrush x:Key="AccentFill" Color="{StaticResource Raised}"/>
      <SolidColorBrush x:Key="AccentFillHover" Color="#F4F6F6"/>
      <SolidColorBrush x:Key="AccentFillPressed" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="SelectionFill" Color="{StaticResource Well}"/>
      <SolidColorBrush x:Key="SelectionEdge" Color="{StaticResource Accent}"/>
      <SolidColorBrush x:Key="TitleText" Color="{StaticResource Ink}"/>

      <LinearGradientBrush x:Key="RaisedEdge" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#F7F8F8"/>
        <GradientStop Offset="0.42" Color="#C5CCCF"/>
        <GradientStop Offset="1" Color="#8E989E"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="WellEdge" StartPoint="50%,0%" EndPoint="50%,100%">
        <GradientStop Offset="0" Color="#6E777C"/>
        <GradientStop Offset="0.4" Color="#8E989E"/>
        <GradientStop Offset="1" Color="#E4E8E9"/>
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="DialFill" StartPoint="32%,0%" EndPoint="70%,100%">
        <GradientStop Offset="0" Color="#F7F8F8"/>
        <GradientStop Offset="0.55" Color="#E7EAEB"/>
        <GradientStop Offset="1" Color="#C5CCCF"/>
      </LinearGradientBrush>

      <StreamGeometry x:Key="IcCompose">M11,4.5 H7 A2.5,2.5 0 0 0 4.5,7 V17 A2.5,2.5 0 0 0 7,19.5 H17 A2.5,2.5 0 0 0 19.5,17 V13 M17.6,3.9 A1.9,1.9 0 0 1 20.3,6.6 L12.5,14.4 L9.5,15 L10.1,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IcGroup">M9,4.5 A3.25,3.25 0 1 1 9,11 A3.25,3.25 0 1 1 9,4.5 Z M3,19.5 C3,16.4 5.7,14 9,14 C12.3,14 15,16.4 15,19.5 M15.5,4.7 A3.1,3.1 0 0 1 15.5,10.8 M17.5,14.3 C19.6,15 21,16.9 21,19.5</StreamGeometry>
      <StreamGeometry x:Key="IcSettings">M4,7.5 H13 M17,7.5 H20 M15,5.5 V9.5 M4,16.5 H7 M11,16.5 H20 M9,14.5 V18.5</StreamGeometry>
      <StreamGeometry x:Key="IcLogout">M13.5,4.5 H17 A2.5,2.5 0 0 1 19.5,7 V17 A2.5,2.5 0 0 1 17,19.5 H13.5 M9.5,8 L5.5,12 L9.5,16 M5.5,12 H15</StreamGeometry>
      <StreamGeometry x:Key="IcInfo">M12,3.5 A8.5,8.5 0 1 1 12,20.5 A8.5,8.5 0 1 1 12,3.5 Z M12,11 V16.2 M12,7.8 V7.9</StreamGeometry>
      <StreamGeometry x:Key="IcSend">M12,19 V5.5 M6.5,11 L12,5.5 L17.5,11</StreamGeometry>
      <StreamGeometry x:Key="IcClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
      <StreamGeometry x:Key="IcSearch">M10.5,4.5 A6,6 0 1 1 10.5,16.5 A6,6 0 1 1 10.5,4.5 Z M15,15 L19.5,19.5</StreamGeometry>
      <StreamGeometry x:Key="IcReply">M9.5,6.5 L4.5,11.5 L9.5,16.5 M4.5,11.5 H13.5 A6,6 0 0 1 19.5,17.5 V18.5</StreamGeometry>
      <StreamGeometry x:Key="IcEdit">M15.8,4.7 A2,2 0 0 1 18.6,7.5 L8.5,17.6 L4.8,18.7 L5.9,15 Z M14,6.5 L16.8,9.3</StreamGeometry>
      <StreamGeometry x:Key="IcTrash">M4.5,7 H19.5 M9.5,7 V5.5 A1,1 0 0 1 10.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V7 M6.5,7 L7.3,18.6 A1.5,1.5 0 0 0 8.8,20 H15.2 A1.5,1.5 0 0 0 16.7,18.6 L17.5,7</StreamGeometry>
      <StreamGeometry x:Key="IcChevronUp">M6.5,14.5 L12,9 L17.5,14.5</StreamGeometry>
      <StreamGeometry x:Key="IcBubble">M12,4 C7,4 3.5,7.2 3.5,11.2 C3.5,13.4 4.6,15.4 6.4,16.7 L5.6,20 L9.4,18.1 C10.2,18.3 11.1,18.4 12,18.4 C17,18.4 20.5,15.2 20.5,11.2 C20.5,7.2 17,4 12,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IcSparkle">M12,3 C12.6,8.2 15.8,11.4 21,12 C15.8,12.6 12.6,15.8 12,21 C11.4,15.8 8.2,12.6 3,12 C8.2,11.4 11.4,8.2 12,3 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource IndustrialHost}"/>
    <Setter Property="FontSize" Value="17"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="Background" Value="#B7BFC2"/>
  </Style>

  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="{StaticResource IndustrialHost}"/>
    <Setter Property="FontSize" Value="54"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-1.4"/>
    <Setter Property="LineHeight" Value="52"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Control.compact TextBlock.display">
    <Setter Property="FontSize" Value="42"/>
    <Setter Property="LineHeight" Value="42"/>
  </Style>
  <Style Selector="Control.narrow TextBlock.display">
    <Setter Property="FontSize" Value="32"/>
    <Setter Property="LineHeight" Value="34"/>
  </Style>
  <Style Selector="Border.screen TextBlock.display">
    <Setter Property="Foreground" Value="{StaticResource OnFieldBrush}"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="LetterSpacing" Value="-0.4"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="LineHeight" Value="22"/>
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  </Style>
  <Style Selector="Border.screen TextBlock.secondary">
    <Setter Property="Foreground" Value="{StaticResource OnFieldMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption, TextBlock.engraved, TextBlock.field">
    <Setter Property="FontFamily" Value="{StaticResource IndustrialPlex}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  </Style>
  <Style Selector="TextBlock.engraved">
    <Setter Property="LetterSpacing" Value="1.1"/>
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Border.screen TextBlock.caption, Border.screen TextBlock.engraved">
    <Setter Property="Foreground" Value="{StaticResource OnFieldMutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.avatarText">
    <Setter Property="Foreground" Value="{StaticResource OnFieldBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.deleted">
    <Setter Property="FontStyle" Value="Italic"/>
    <Setter Property="Opacity" Value="0.65"/>
  </Style>

  <Style Selector="local|Glyph">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
  </Style>

  <Style Selector="Border.housing">
    <Setter Property="Background" Value="{StaticResource ChassisBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="0 12 28 0 #33181E22, inset 0 1 0 0 #F7F8F8"/>
  </Style>
  <!-- На macOS корпус совпадает с окном: системное скругление и светофоры, без второй рамки. -->
  <Style Selector="Border.housing.flush">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BoxShadow" Value="none"/>
  </Style>
  <Style Selector="Border.screw">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="#9AA3A8"/>
    <Setter Property="BorderBrush" Value="#F4F6F6"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="inset 0 1 1 0 #5C656A"/>
  </Style>
  <Style Selector="Border.vent">
    <Setter Property="Width" Value="3"/>
    <Setter Property="Height" Value="16"/>
    <Setter Property="CornerRadius" Value="1"/>
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="inset 0 1 1 0 #6E777C"/>
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Control.stack Border.sidebar">
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="MaxHeight" Value="220"/>
  </Style>
  <Style Selector="Border.deck">
    <Setter Property="Background" Value="{StaticResource ChassisBrush}"/>
  </Style>
  <Style Selector="Border.screen">
    <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="inset 0 3 8 0 #80181E22"/>
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource ChassisBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Border.capsule">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="4"/>
    <Setter Property="BoxShadow" Value="0 1 0 0 #8E989E, inset 0 1 0 0 #FFFFFF"/>
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="BoxShadow" Value="0 16 36 0 #55181E22, inset 0 1 0 0 #FFFFFF"/>
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="BoxShadow" Value="0 8 18 0 #44181E22"/>
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="10,3,4,3"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IndustrialPlex}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="inset 0 1 2 0 #66181E22"/>
  </Style>
  <Style Selector="Border.unread">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
  </Style>

  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,8"/>
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="Background" Value="{StaticResource BubbleMine}"/>
    <Setter Property="BorderBrush" Value="#3A444A"/>
  </Style>

  <Style Selector="Border.reaction">
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="Margin" Value="0,0,5,3"/>
    <Setter Property="Background" Value="#2A3236"/>
    <Setter Property="BorderBrush" Value="#4A555B"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.reaction:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource OnFieldMutedBrush}"/>
  </Style>
  <Style Selector="Border.reaction.active">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BoxShadow" Value="inset 3 0 0 0 #F15B22"/>
  </Style>

  <!-- Клавиши -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource RaisedEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="FontFamily" Value="{StaticResource IndustrialHost}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="RenderTransform" Value="none"/>
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="BackEaseOut"/>
        <BrushTransition Property="Background" Duration="0:0:0.14" Easing="BackEaseOut"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="RenderTransform" Value="translateY(-1px)"/>
    <Setter Property="Background" Value="#F4F6F6"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="RenderTransform" Value="translateY(1px)"/>
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  </Style>
  <Style Selector="Window.reduce-motion Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.01"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Window.reduce-motion Button:pointerover, Window.reduce-motion Button:pressed">
    <Setter Property="RenderTransform" Value="none"/>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{TemplateBinding Background}"/>
    <Setter Property="BorderBrush" Value="{TemplateBinding BorderBrush}"/>
    <Setter Property="CornerRadius" Value="{TemplateBinding CornerRadius}"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F4F6F6"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
  </Style>

  <Style Selector="Button.large">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="FontSize" Value="16"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.glow">
    <Setter Property="Effect" Value="{x:Null}"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="{StaticResource RaisedBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F4F6F6"/>
  </Style>
  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="MinHeight" Value="0"/>
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource ChassisBrush}"/>
  </Style>
  <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
  </Style>

  <Style Selector="Button.dial">
    <Setter Property="Width" Value="92"/>
    <Setter Property="Height" Value="92"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="8"/>
    <Setter Property="CornerRadius" Value="46"/>
    <Setter Property="Background" Value="{StaticResource DialFill}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.dial:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#F7F8F8"/>
  </Style>
  <Style Selector="Button.dial:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
  </Style>
  <Style Selector="Button.dial:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="#8E989E"/>
