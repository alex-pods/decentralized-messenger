    <Setter Property="BorderBrush" Value="#3A444A"/>
  </Style>
  <Style Selector="Border.screen TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource OnFieldMutedBrush}"/>
  </Style>

  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{StaticResource ScreenInset}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="6,4,6,4"/>
    <Setter Property="BoxShadow" Value="inset 0 2 4 0 #80181E22"/>
  </Style>

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.screenbay">
