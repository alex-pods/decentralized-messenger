  <Style Selector="Control.narrow Button.send">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="17"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource IndustrialHost}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource InkBrush}"/>
    <Setter Property="SelectionBrush" Value="#66F15B22"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource FieldFillHover}"/>
    <Setter Property="BorderBrush" Value="{StaticResource WellEdge}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{StaticResource WellBrush}"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
    <Setter Property="FontFamily" Value="{StaticResource IndustrialPlex}"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource OnFieldBrush}"/>
    <Setter Property="CaretBrush" Value="{StaticResource OnFieldBrush}"/>
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
