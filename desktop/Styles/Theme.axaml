<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MessengerDesktop">
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource BodyFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ChassisBrush}"/>
  </Style>
  <Style Selector="TextBlock.caption, TextBlock.engraved">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.avatarText">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="local|Glyph">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
  </Style>
  <Style Selector="Border.screen, Border.deck">
    <Setter Property="Background" Value="{DynamicResource ChassisBrush}"/>
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="CornerRadius" Value="24"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="16"/>
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="Background" Value="{DynamicResource BubbleMine}"/>
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="20"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.glass, Border.capsule, Border.toast">
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Border.reaction, Border.chip">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6,3"/>
  </Style>
  <Style Selector="Border.reaction.active">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="Border.unread">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="4"/>
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SelectionFill}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value=".45"/>
  </Style>
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="Padding" Value="8"/>
  </Style>
  <Style Selector="Button.small, Button.toolbar">
    <Setter Property="Padding" Value="8,4"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.primary, Button.send">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
  </Style>
  <Style Selector="Button.send">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="10"/>
  </Style>
  <Style Selector="Button.link">
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="20"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="MinHeight" Value="42"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Background" Value="{DynamicResource RaisedBrush}"/>
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,8"/>
  </Style>
  <Style Selector="TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="Margin" Value="10,2"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem, ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:selected Border.bubble">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</Styles>