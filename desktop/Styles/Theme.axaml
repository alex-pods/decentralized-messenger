<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MessengerDesktop">
  <!-- Тёмная плоская тема в духе ChatGPT: нейтральные серые, без стекла, градиентов и теней. -->
  <Styles.Resources>
    <ResourceDictionary>
      <x:Double x:Key="ControlContentThemeFontSize">14</x:Double>
      <Thickness x:Key="ChromeLeading">12,0,12,0</Thickness>

      <!-- Палитра -->
      <Color x:Key="BgMain">#212121</Color>
      <Color x:Key="BgSidebar">#171717</Color>
      <Color x:Key="BgElevated">#2F2F2F</Color>
      <Color x:Key="BgHover">#3A3A3A</Color>
      <Color x:Key="LineColor">#424242</Color>

      <SolidColorBrush x:Key="MainFill" Color="{StaticResource BgMain}"/>
      <SolidColorBrush x:Key="SidebarFill" Color="{StaticResource BgSidebar}"/>
      <SolidColorBrush x:Key="ElevatedFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="HoverFill" Color="{StaticResource BgHover}"/>
      <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}"/>

      <SolidColorBrush x:Key="LabelPrimary" Color="#ECECEC"/>
      <SolidColorBrush x:Key="LabelSecondary" Color="#B4B4B4"/>
      <SolidColorBrush x:Key="LabelTertiary" Color="#8E8E8E"/>
      <SolidColorBrush x:Key="AccentBrush" Color="#ECECEC"/>
      <SolidColorBrush x:Key="DangerBrush" Color="#F93A37"/>
      <SolidColorBrush x:Key="OnlineBrush" Color="#19C37D"/>
      <SolidColorBrush x:Key="SeparatorBrush" Color="#2F2F2F"/>

      <!-- Совместимость с именами, которые используют вью -->
      <SolidColorBrush x:Key="PanelFill" Color="{StaticResource BgMain}"/>
      <SolidColorBrush x:Key="GlassFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="GlassFillHover" Color="{StaticResource BgHover}"/>
      <SolidColorBrush x:Key="GlassFillPressed" Color="#262626"/>
      <SolidColorBrush x:Key="RowHover" Color="{StaticResource BgMain}"/>
      <SolidColorBrush x:Key="SheetFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="ToastFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="FieldFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="FieldFillHover" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="FieldBorder" Color="{StaticResource LineColor}"/>
      <SolidColorBrush x:Key="DimBrush" Color="#99000000"/>
      <SolidColorBrush x:Key="BubbleTheirs" Color="Transparent"/>
      <SolidColorBrush x:Key="BubbleMine" Color="{StaticResource BgElevated}"/>

      <SolidColorBrush x:Key="GlassEdge" Color="Transparent"/>
      <SolidColorBrush x:Key="PanelEdge" Color="{StaticResource LineColor}"/>
      <SolidColorBrush x:Key="AccentFill" Color="#ECECEC"/>
      <SolidColorBrush x:Key="AccentFillHover" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="AccentFillPressed" Color="#D4D4D4"/>
      <SolidColorBrush x:Key="SelectionFill" Color="{StaticResource BgElevated}"/>
      <SolidColorBrush x:Key="SelectionEdge" Color="Transparent"/>
      <SolidColorBrush x:Key="TitleText" Color="#ECECEC"/>

      <!-- Иконки: контурные пути в коробке 24×24, рисует local:Glyph -->
      <StreamGeometry x:Key="IcCompose">M11,4.5 H7 A2.5,2.5 0 0 0 4.5,7 V17 A2.5,2.5 0 0 0 7,19.5 H17 A2.5,2.5 0 0 0 19.5,17 V13 M17.6,3.9 A1.9,1.9 0 0 1 20.3,6.6 L12.5,14.4 L9.5,15 L10.1,12 Z</StreamGeometry>
      <StreamGeometry x:Key="IcGroup">M9,4.5 A3.25,3.25 0 1 1 9,11 A3.25,3.25 0 1 1 9,4.5 Z M3,19.5 C3,16.4 5.7,14 9,14 C12.3,14 15,16.4 15,19.5 M15.5,4.7 A3.1,3.1 0 0 1 15.5,10.8 M17.5,14.3 C19.6,15 21,16.9 21,19.5</StreamGeometry>
      <StreamGeometry x:Key="IcSettings">M4,7.5 H13 M17,7.5 H20 M15,5.5 V9.5 M4,16.5 H7 M11,16.5 H20 M9,14.5 V18.5</StreamGeometry>
      <StreamGeometry x:Key="IcLogout">M13.5,4.5 H17 A2.5,2.5 0 0 1 19.5,7 V17 A2.5,2.5 0 0 1 17,19.5 H13.5 M9.5,8 L5.5,12 L9.5,16 M5.5,12 H15</StreamGeometry>
      <StreamGeometry x:Key="IcInfo">M12,3.5 A8.5,8.5 0 1 1 12,20.5 A8.5,8.5 0 1 1 12,3.5 Z M12,11 V16.2 M12,7.8 V7.9</StreamGeometry>
      <StreamGeometry x:Key="IcSend">M12,19 V5.5 M6.5,11 L12,5.5 L17.5,11</StreamGeometry>
      <StreamGeometry x:Key="IcClose">M6.5,6.5 L17.5,17.5 M17.5,6.5 L6.5,17.5</StreamGeometry>
      <StreamGeometry x:Key="IcSearch">M10.5,4.5 A6,6 0 1 1 10.5,16.5 A6,6 0 1 1 10.5,4.5 Z M15,15 L19.5,19.5</StreamGeometry>
      <StreamGeometry x:Key="IcReply">M9.5,6.5 L4.5,11.5 L9.5,16.5 M4.5,11.5 H13.5 A6,6 0 0 1 19.5,17.5 V18.5</StreamGeometry>
      <StreamGeometry x:Key="IcEdit">M15.8,4.7 A2,2 0 0 1 18.6,7.5 L8.5,17.6 L4.8,18.7 L5.9,15 Z M14,6.5 L16.8,9.3</StreamGeometry>
      <StreamGeometry x:Key="IcTrash">M4.5,7 H19.5 M9.5,7 V5.5 A1,1 0 0 1 10.5,4.5 H13.5 A1,1 0 0 1 14.5,5.5 V7 M6.5,7 L7.3,18.6 A1.5,1.5 0 0 0 8.8,20 H15.2 A1.5,1.5 0 0 0 16.7,18.6 L17.5,7</StreamGeometry>
      <StreamGeometry x:Key="IcChevronUp">M6.5,14.5 L12,9 L17.5,14.5</StreamGeometry>
      <StreamGeometry x:Key="IcBubble">M12,4 C7,4 3.5,7.2 3.5,11.2 C3.5,13.4 4.6,15.4 6.4,16.7 L5.6,20 L9.4,18.1 C10.2,18.3 11.1,18.4 12,18.4 C17,18.4 20.5,15.2 20.5,11.2 C20.5,7.2 17,4 12,4 Z</StreamGeometry>
      <StreamGeometry x:Key="IcSparkle">M12,3 C12.6,8.2 15.8,11.4 21,12 C15.8,12.6 12.6,15.8 12,21 C11.4,15.8 8.2,12.6 3,12 C8.2,11.4 11.4,8.2 12,3 Z</StreamGeometry>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
  </Style>

  <!-- Текст -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.secondary">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
  </Style>
  <Style Selector="TextBlock.field">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
  </Style>
  <Style Selector="TextBlock.avatarText">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBlock.deleted">
    <Setter Property="FontStyle" Value="Italic"/>
    <Setter Property="Opacity" Value="0.6"/>
  </Style>

  <Style Selector="local|Glyph">
    <Setter Property="Width" Value="18"/>
    <Setter Property="Height" Value="18"/>
  </Style>

  <!-- Поверхности -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.sidebar">
    <Setter Property="Background" Value="{DynamicResource SidebarFill}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.glass">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.capsule">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="3"/>
  </Style>
  <Style Selector="Border.sheet">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="16"/>
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="14,10"/>
  </Style>
  <Style Selector="Border.group">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="CornerRadius" Value="12"/>
  </Style>
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="14"/>
    <Setter Property="Padding" Value="11,3,4,3"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="7,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
  </Style>
  <Style Selector="Border.avatar">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="Border.unread">
    <Setter Property="Width" Value="8"/>
    <Setter Property="Height" Value="8"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Background" Value="{DynamicResource LabelPrimary}"/>
  </Style>

  <!-- Сообщения: чужие — просто текст слева, свои — серый пузырь справа (как в ChatGPT) -->
  <Style Selector="Border.bubble">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.bubble.mine">
    <Setter Property="Background" Value="{DynamicResource BubbleMine}"/>
    <Setter Property="CornerRadius" Value="18"/>
  </Style>

  <!-- Кнопки -->
  <Style Selector="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="14,6"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource SeparatorBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
  </Style>

  <Style Selector="Button.large">
    <Setter Property="MinHeight" Value="44"/>
    <Setter Property="CornerRadius" Value="22"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.small">
    <Setter Property="MinHeight" Value="26"/>
    <Setter Property="Padding" Value="10,2"/>
    <Setter Property="CornerRadius" Value="13"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>

  <!-- Основная кнопка: белая с чёрным текстом -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
    <Setter Property="FontWeight" Value="Medium"/>
  </Style>
  <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHover}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillPressed}"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
  </Style>
  <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
  </Style>
  <Style Selector="Button.glow">
    <Setter Property="Effect" Value="{x:Null}"/>
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#26F93A37"/>
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>
  <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
  </Style>

  <Style Selector="Button.toolbar">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="MinWidth" Value="32"/>
    <Setter Property="MinHeight" Value="30"/>
    <Setter Property="Padding" Value="9,0"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
  </Style>
  <Style Selector="Button.toolbar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="CornerRadius" Value="6"/>
  </Style>
  <Style Selector="Button.row">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
  </Style>
  <!-- Кнопка отправки: белый круг с чёрной стрелкой -->
  <Style Selector="Button.send">
    <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="CornerRadius" Value="18"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Button.send:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillHover}"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
  </Style>
  <Style Selector="Button.send:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentFillPressed}"/>
    <Setter Property="Foreground" Value="#0D0D0D"/>
  </Style>
  <Style Selector="Button.send:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
  </Style>

  <!-- Поля ввода -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource LabelPrimary}"/>
    <Setter Property="SelectionBrush" Value="#59ECECEC"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="BorderBrush" Value="#5A5A5A"/>
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource FieldFill}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LabelSecondary}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style Selector="TextBox:focus">
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>
  <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox:focus /template/ TextBlock#PART_Watermark">
    <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
  </Style>

  <!-- В модальных окнах (фон #2F2F2F) поля темнее, чтобы читались -->
  <Style Selector="Border.sheet TextBox">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
  </Style>
  <Style Selector="Border.sheet TextBox:pointerover /template/ Border#PART_BorderElement, Border.sheet TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
  </Style>

  <!-- Поле без рамки внутри своего контейнера (композер) -->
  <Style Selector="TextBox.bare">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,9"/>
    <Setter Property="MinHeight" Value="40"/>
    <Setter Property="FontSize" Value="15"/>
  </Style>
  <Style Selector="TextBox.bare:pointerover /template/ Border#PART_BorderElement, TextBox.bare:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="26"/>
    <Setter Property="Padding" Value="8,6,8,6"/>
  </Style>

  <!-- Списки -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="ListBox.sidebar ListBoxItem">
    <Setter Property="Padding" Value="8,7"/>
    <Setter Property="Margin" Value="8,1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12"/>
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainFill}"/>
  </Style>
  <Style Selector="ListBox.sidebar ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.sidebar ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource ElevatedFill}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelPrimary}"/>
  </Style>

  <Style Selector="ListBox.log ListBoxItem, ListBox.plain ListBoxItem">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem">
    <Setter Property="Padding" Value="0,1"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ListBox.plain ListBoxItem">
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.log ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter, ListBox.plain ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <!-- Выбранное сообщение: тонкая серая обводка -->
  <Style Selector="ListBox.log ListBoxItem:selected Border.bubble">
    <Setter Property="BorderBrush" Value="#6E6E6E"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:pointerover Border.bubble">
    <Setter Property="Background" Value="#1AFFFFFF"/>
  </Style>
  <Style Selector="ListBox.log ListBoxItem:pointerover Border.bubble.mine">
    <Setter Property="Background" Value="{DynamicResource HoverFill}"/>
  </Style>

  <!-- Оверлеи: без размытия фона, лёгкое появление -->
  <Style Selector="Border.scrim[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.15" FillMode="Forward">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0"/></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Border.toast[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.2" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="TranslateTransform.Y" Value="8"/>
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="TranslateTransform.Y" Value="0"/>
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
