<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop" xmlns:views="using:MessengerDesktop.Views.Dialogs"
             x:Class="MessengerDesktop.Views.Dialogs.ConversationDetails" VerticalAlignment="Top">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="8">
    <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding ShowMembersCommand.IsRunning}"/>
    <Button x:Name="OpenConversationPins" Classes="profileRow" Click="OnPinsClick">
      <Grid ColumnDefinitions="Auto,*,Auto"><local:Glyph Data="{StaticResource IcPin}"/><TextBlock Grid.Column="1" Text="Закреплённые сообщения" TextWrapping="Wrap" Margin="14,0" VerticalAlignment="Center"/><local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16"/></Grid>
    </Button>
    <Border Height="1" Background="{DynamicResource LineBrush}"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="4">
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,4"/>
      <Button x:Name="HideConversation" Classes="profileRow" Click="OnHideClick">
        <Grid ColumnDefinitions="Auto,*"><local:Glyph Data="{StaticResource IcEyeOff}"/><TextBlock Grid.Column="1" Text="Скрыть чат у себя" Margin="14,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
      </Button>
      <Button x:Name="LeaveConversation" Classes="profileRow danger" Click="OnLeaveClick" IsVisible="{Binding IsGroup}">
        <Grid ColumnDefinitions="Auto,*"><local:Glyph Data="{StaticResource IcLogout}"/><TextBlock Grid.Column="1" Text="Покинуть группу" Margin="14,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
      </Button>
    </StackPanel>
    <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0">
      <TextBlock Text="{Binding Members.Count, StringFormat='Участники ({0})'}" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <Expander x:Name="AddMemberSection" Grid.Row="1" Header="Добавить участника" HorizontalAlignment="Stretch"
                IsVisible="{Binding CanInviteMembers}" Margin="0,0,0,8">
        <views:PeopleSearch Margin="0,10,0,0"/>
      </Expander>
      <views:MemberList x:Name="MemberDirectory" Grid.Row="2"/>
    </Grid>
  </DockPanel>
</UserControl>
