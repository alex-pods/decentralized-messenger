<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Views.Dialogs.ForwardPicker" x:Name="Root">
  <StackPanel Spacing="12">
  <TextBlock Text="Выберите получателя" Classes="secondary"/>
  <TextBox x:Name="DestinationSearch" Watermark="Найти чат" TextChanged="OnSearchChanged"/>
  <TextBlock x:Name="NoResults" Text="Чаты не найдены" Classes="caption" IsVisible="False"/>
  <ListBox x:Name="Destinations" Classes="plain" ItemsSource="{Binding Chats}" MaxHeight="360">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <Button Classes="row" Command="{Binding DataContext.ForwardToCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12">
          <Grid ColumnDefinitions="Auto,*">
            <Border Classes="avatar" Width="30" Height="30" ClipToBounds="True" Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
              <Panel>
                <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                <TextBlock Classes="avatarText" Text="{Binding Title, Converter={StaticResource Initial}}" IsVisible="{Binding ShowInitial}"/>
                <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16" StrokeWidth="1.8" Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
              </Panel>
            </Border>
            <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
          </Grid>
        </Button>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
  </StackPanel>
</UserControl>
