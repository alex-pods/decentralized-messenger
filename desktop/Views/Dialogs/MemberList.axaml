<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Views.Dialogs.MemberList" x:Name="Root">
  <ListBox x:Name="GroupMembers" Classes="plain memberRows" ItemsSource="{Binding Members}"
           ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.AllowAutoHide="False"
           AutomationProperties.Name="Участники группы">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <Grid ColumnDefinitions="*,Auto" Margin="0,2">
          <Button Classes="row" Click="OnOpenProfile" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="0,5" ToolTip.Tip="Открыть профиль">
            <Grid ColumnDefinitions="Auto,*">
          <Border Classes="avatar" Width="34" Height="34" VerticalAlignment="Top" ClipToBounds="True" Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
            <Panel>
              <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
              <TextBlock Classes="avatarText" Text="{Binding Title, Converter={StaticResource Initial}}" IsVisible="{Binding !HasAvatar}"/>
            </Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="3" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Detail}"/>
          </StackPanel>
            </Grid>
          </Button>
          <Button Classes="icon" Click="OnMemberMenu" IsVisible="{Binding CanKick}" Grid.Column="1" VerticalAlignment="Center"
                  ToolTip.Tip="Управление участником" AutomationProperties.Name="Управление участником">
            <local:Glyph Data="{StaticResource IcMore}"/>
          </Button>
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
