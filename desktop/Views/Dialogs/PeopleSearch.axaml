<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Views.Dialogs.PeopleSearch" x:Name="Root">
  <StackPanel Spacing="8" Margin="0,0,0,8">
    <TextBlock Text="Найти человека по тегу" Classes="field" Margin="0,0,0,4"/>
    <Grid ColumnDefinitions="*,Auto">
      <TextBox Text="{Binding SearchQuery}" Watermark="Например, @alex" IsEnabled="{Binding !Searching}">
        <TextBox.InnerLeftContent>
          <local:Glyph Data="{StaticResource IcSearch}" Width="15" Height="15" Margin="12,0,0,0" Foreground="{DynamicResource LabelBrush}"/>
        </TextBox.InnerLeftContent>
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
        </TextBox.KeyBindings>
      </TextBox>
      <Button Grid.Column="1" Classes="secondaryAction" Content="Найти" IsEnabled="{Binding !Searching}" Margin="8,0,0,0" MinHeight="40" Command="{Binding SearchCommand}"/>
    </Grid>
    <TextBlock Text="{Binding SearchHint}" Classes="caption" TextWrapping="Wrap"/>
    <ListBox Classes="plain" ItemsSource="{Binding SearchResults}" MaxHeight="190">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Button Classes="row" Command="{Binding DataContext.PickUserCommand, ElementName=Root}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12">
            <Grid ColumnDefinitions="Auto,*">
              <Border Classes="avatar" Width="30" Height="30" ClipToBounds="True" Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
                <Panel>
                  <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                  <TextBlock Classes="avatarText" Text="{Binding Label, Converter={StaticResource Initial}}" IsVisible="{Binding !HasAvatar}"/>
                </Panel>
              </Border>
              <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding NameLabel}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding TagLabel}" Classes="caption" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Button>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </StackPanel>
</UserControl>
