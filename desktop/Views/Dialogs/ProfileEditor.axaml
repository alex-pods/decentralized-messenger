<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop" xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="MessengerDesktop.Views.Dialogs.ProfileEditor" x:Name="Root">
  <StackPanel Spacing="0">
    <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding ShowProfileCommand.IsRunning}"/>
    <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
      <Border Width="56" Height="56" CornerRadius="28" Background="{Binding CurrentUserId, Converter={StaticResource AvatarBrush}}"
              ClipToBounds="True" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAvatarDragOver" DragDrop.Drop="OnAvatarDrop">
        <Panel>
          <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
          <TextBlock Classes="avatarText" Text="{Binding DisplayName, Converter={StaticResource Initial}}" FontSize="28" IsVisible="{Binding !HasAvatar}"/>
          <Image Source="{Binding DraftAvatar}" Stretch="UniformToFill" IsVisible="{Binding HasDraftAvatar}"/>
        </Panel>
      </Border>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="5">
        <TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
        <Button x:Name="CopyTag" Click="OnCopyTag" HorizontalAlignment="Left" HorizontalContentAlignment="Left" Padding="0" MinHeight="24"
                ToolTip.Tip="Скопировать тег" AutomationProperties.Name="Скопировать мой тег">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="{Binding UserTag}" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
            <local:Glyph Data="{StaticResource IcCopy}" Width="13" Height="13" Foreground="{DynamicResource LabelBrush}"/>
          </StackPanel>
        </Button>
        <TextBlock x:Name="TagCopied" Text="Тег скопирован" Classes="caption" IsVisible="False"/>
      </StackPanel>
    </Grid>
    <StackPanel x:Name="AccountPanel" Spacing="0" IsVisible="{Binding !ProfileEditing}">
      <TextBlock Text="{Binding Bio}" Classes="secondary" Margin="0,0,0,16" TextWrapping="Wrap"
                 IsVisible="{Binding Bio, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
      <Button x:Name="EditProfile" Click="OnEditProfile" Classes="profileRow" IsEnabled="{Binding !ShowProfileCommand.IsRunning}">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <local:Glyph Data="{StaticResource IcEdit}"/>
          <TextBlock Grid.Column="1" Margin="14,0" Text="Редактировать профиль" VerticalAlignment="Center" TextWrapping="Wrap"/>
          <local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16"/>
        </Grid>
      </Button>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,6"/>
      <Button Click="OnPreferencesClick" Tag="PrivacySection" Classes="profileRow">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <local:Glyph Data="{StaticResource IcShield}"/>
          <StackPanel Grid.Column="1" Margin="14,0" Spacing="4"><TextBlock Text="Приватность"/><TextBlock x:Name="PrivacySummary" Classes="caption" TextWrapping="Wrap"/></StackPanel>
          <local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16"/>
        </Grid>
      </Button>
      <Button Click="OnPreferencesClick" Tag="MessagesSection" Classes="profileRow">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <local:Glyph Data="{StaticResource IcBubble}"/>
          <StackPanel Grid.Column="1" Margin="14,0" Spacing="4"><TextBlock Text="Отправка сообщений"/><TextBlock x:Name="MessagesSummary" Classes="caption" TextWrapping="Wrap"/></StackPanel>
          <local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16"/>
        </Grid>
      </Button>
      <Button Click="OnAppearanceClick" Classes="profileRow">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <local:Glyph Data="{StaticResource IcPalette}"/>
          <StackPanel Grid.Column="1" Margin="14,0" Spacing="4"><TextBlock Text="Оформление"/><TextBlock x:Name="ThemeSummary" Classes="caption" TextWrapping="Wrap"/></StackPanel>
          <local:Glyph Grid.Column="2" Data="{StaticResource IcChevronRight}" Width="16" Height="16"/>
        </Grid>
      </Button>
      <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,6"/>
      <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,2">
        <Button Classes="secondaryAction" Click="OnSwitchAccountClick" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <local:Glyph Data="{StaticResource IcServer}" Width="16" Height="16"/>
            <TextBlock Text="Сменить аккаунт" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="secondaryAction" Command="{Binding AddAccountCommand}" HorizontalAlignment="Stretch">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <local:Glyph Data="{StaticResource IcPlus}" Width="16" Height="16"/>
            <TextBlock Text="Добавить аккаунт" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>
      <Button Click="OnLogoutClick" Classes="profileRow danger">
        <StackPanel Orientation="Horizontal" Spacing="14"><local:Glyph Data="{StaticResource IcLogout}"/><TextBlock Text="Выйти из аккаунта" VerticalAlignment="Center"/></StackPanel>
      </Button>
    </StackPanel>
    <StackPanel x:Name="EditPanel" IsVisible="{Binding ProfileEditing}" IsEnabled="{Binding !SaveProfileCommand.IsRunning}" Spacing="8">
      <Button Content="Выбрать фото…" Click="OnChooseAvatarClick" Classes="secondaryAction" HorizontalAlignment="Left" Margin="0,0,0,6"/>
      <TextBlock Classes="field" Text="Отображаемое имя"/>
      <TextBox x:Name="ProfileName" Text="{Binding DisplayName}" MaxLength="32" AutomationProperties.Name="Отображаемое имя" IsEnabled="{Binding !ShowProfileCommand.IsRunning}"/>
      <TextBlock Classes="field" Text="О себе" Margin="0,8,0,0"/>
      <TextBox Text="{Binding Bio}" MaxLength="500" AutomationProperties.Name="О себе" IsEnabled="{Binding !ShowProfileCommand.IsRunning}"
               AcceptsReturn="True" MinHeight="74" MaxHeight="180" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
      <Grid ColumnDefinitions="*,8,*" Margin="0,8,0,0">
        <Button x:Name="CancelEdit" Classes="secondaryAction" Click="OnCancelEdit" Content="Отмена" HorizontalAlignment="Stretch"/>
        <Button Grid.Column="2" Classes="primary" Content="Сохранить" Command="{Binding SaveProfileCommand}" HorizontalAlignment="Stretch"/>
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
