<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Views.Dialogs.UserProfileWindow"
        Title="Профиль пользователя" Width="440" SizeToContent="Height" MaxHeight="720" MinWidth="320" MinHeight="380"
        SystemDecorations="BorderOnly" WindowStartupLocation="CenterOwner" Background="{DynamicResource RaisedBrush}">
  <DockPanel Margin="24">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,24">
      <Border Background="Transparent" PointerPressed="OnHeaderPressed">
        <TextBlock Text="Профиль" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
      </Border>
      <local:DismissButton x:Name="CloseProfile" Grid.Column="1" AutomationProperties.Name="Закрыть профиль"/>
    </Grid>
    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,20,0,0">
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" IsVisible="False"/>
      <Button x:Name="Retry" Content="Попробовать снова" IsVisible="False"/>
      <Button x:Name="WriteMessage" Classes="primary" Content="Написать сообщение" HorizontalAlignment="Stretch" MinHeight="42" IsEnabled="False"/>
    </StackPanel>
    <ScrollViewer Classes="dialogScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                  AllowAutoHide="False" MaxHeight="420" ClipToBounds="True" SizeChanged="OnProfileSizeChanged">
      <StackPanel x:Name="ProfileContent" Spacing="20" HorizontalAlignment="Left">
        <ProgressBar x:Name="Loading" IsIndeterminate="True" Height="2"/>
        <Grid ColumnDefinitions="Auto,*">
          <Border Classes="avatar" Width="76" Height="76" CornerRadius="38" Background="{DynamicResource AccentFill}">
            <Panel><Image x:Name="Photo" Stretch="UniformToFill"/><TextBlock x:Name="Initial" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/></Panel>
          </Border>
          <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="6" VerticalAlignment="Center">
            <TextBlock x:Name="PersonName" Text="Загрузка…" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="Activity" Classes="caption" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
        <Button x:Name="CopyUsername" Classes="profileRow" IsVisible="False" ToolTip.Tip="Скопировать тег">
          <StackPanel Spacing="6"><TextBlock Text="Имя пользователя" Classes="caption"/><TextBlock x:Name="Username" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/></StackPanel>
        </Button>
        <StackPanel x:Name="About" Spacing="8" IsVisible="False"><TextBlock Text="О себе" Classes="caption"/><TextBlock x:Name="Biography" TextWrapping="Wrap"/></StackPanel>
        <TextBlock x:Name="Joined" Classes="caption" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
