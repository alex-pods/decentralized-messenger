<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:MessengerDesktop"
             x:Class="MessengerDesktop.Views.LoginView"
             Background="Transparent"
             PointerPressed="OnDragAreaPressed">
  <Border Classes="sheet" Width="400" Padding="34,36,34,26"
          HorizontalAlignment="Center" VerticalAlignment="Center">
    <StackPanel Spacing="8">
      <Panel HorizontalAlignment="Center" Width="76" Height="76">
        <Border CornerRadius="24" Background="{DynamicResource AccentFill}" Opacity="0.55">
          <Border.Effect>
            <BlurEffect Radius="26"/>
          </Border.Effect>
        </Border>
        <Border CornerRadius="24" Background="{DynamicResource AccentFill}"
                BorderBrush="#4DFFFFFF" BorderThickness="1">
          <Panel>
            <local:Glyph Data="{StaticResource IcBubble}" Width="38" Height="38" StrokeWidth="2.1" Foreground="White"/>
            <local:Glyph Data="{StaticResource IcSparkle}" Width="14" Height="14" StrokeWidth="1.6" Foreground="White"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0"/>
          </Panel>
        </Border>
      </Panel>

      <TextBlock Text="Мессенджер" FontSize="28" FontWeight="Bold" LetterSpacing="-0.6"
                 Foreground="{DynamicResource TitleText}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
      <TextBlock Text="Ваш сервер. Ваши разговоры." Classes="secondary" FontSize="13.5" HorizontalAlignment="Center"/>

      <StackPanel Spacing="6" Margin="0,22,0,0">
        <TextBlock Classes="field" Text="Сервер"/>
        <TextBox Text="{Binding Server}" Watermark="https://…/messenger"/>
        <TextBlock Classes="field" Text="Логин" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Login}" Watermark="3–16 символов"/>
        <TextBlock Classes="field" Text="Пароль" Margin="0,8,0,0"/>
        <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="минимум 8 символов">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>
      </StackPanel>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 Margin="0,4,0,0"
                 IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

      <Button Classes="accent large glow" Content="Войти" Command="{Binding SignInCommand}"
              HorizontalAlignment="Stretch" Margin="0,16,0,0"
              IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/>
      <Button Classes="large" Content="Создать аккаунт" Command="{Binding SignUpCommand}"
              HorizontalAlignment="Stretch" FontWeight="Medium"
              IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/>
      <TextBlock Classes="caption" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                 Text="Регистрация создаёт аккаунт и сразу входит. Сессия сохранится на этом компьютере."/>
    </StackPanel>
  </Border>
</UserControl>
