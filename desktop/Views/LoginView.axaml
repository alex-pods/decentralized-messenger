<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:MessengerDesktop"
             x:Class="MessengerDesktop.Views.LoginView">
  <UserControl.Resources>
    <StreamGeometry x:Key="IcEye">M2,12 C4.5,7.5 8,5 12,5 C16,5 19.5,7.5 22,12 C19.5,16.5 16,19 12,19 C8,19 4.5,16.5 2,12 Z M12,9 A3,3 0 1 1 12,15 A3,3 0 1 1 12,9 Z</StreamGeometry>
    <StreamGeometry x:Key="IcEyeOff">M3,4 L21,20 M9.5,6.2 C10.3,6 11.1,5.9 12,5.9 C16,5.9 19.5,8.4 22,12.9 C21.1,14.4 20,15.7 18.8,16.8 M14.1,15.2 A3,3 0 0 1 9.2,10.3 M6.2,8.4 C4.6,9.6 3.2,11.1 2,12.9 C3.4,15.2 5.2,17 7.2,18.2</StreamGeometry>
    <StreamGeometry x:Key="IcChevronRight">M9,6 L15,12 L9,18</StreamGeometry>
    <StreamGeometry x:Key="IcGear">M12,9.2 A2.8,2.8 0 1 0 12.01,9.2 Z M12,10.6 A1.4,1.4 0 1 1 11.99,10.6 Z M12,3.4 V6.1 M12,17.9 V20.6 M3.4,12 H6.1 M17.9,12 H20.6 M5.9,5.9 L7.8,7.8 M16.2,16.2 L18.1,18.1 M18.1,5.9 L16.2,7.8 M7.8,16.2 L5.9,18.1</StreamGeometry>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.loginGo">
      <Setter Property="Background" Value="#E4571A"/>
      <Setter Property="BorderBrush" Value="#C44712"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="Button.loginGo /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E4571A"/>
      <Setter Property="BorderBrush" Value="#C44712"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.loginGo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F0672A"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.loginGo:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#C44712"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.loginGo:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#E7B9A4"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.eye, Button.disclosure, Button.link">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="RenderTransform" Value="none"/>
    </Style>
    <Style Selector="Button.eye /template/ ContentPresenter#PART_ContentPresenter, Button.disclosure /template/ ContentPresenter#PART_ContentPresenter, Button.link /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.eye:pointerover, Button.eye:pressed, Button.disclosure:pointerover, Button.disclosure:pressed, Button.link:pointerover, Button.link:pressed">
      <Setter Property="RenderTransform" Value="none"/>
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.eye:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.disclosure:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.eye:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.disclosure:pressed /template/ ContentPresenter#PART_ContentPresenter, Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="Button.link TextBlock">
      <Setter Property="TextDecorations" Value="Underline"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBox.loginField">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C5C9CC"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="MinHeight" Value="40"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TextBox.loginField:pointerover /template/ Border#PART_BorderElement, TextBox.loginField:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="TextBox.loginField:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Border.cornerScrew">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Background" Value="#6A7176"/>
      <Setter Property="BorderBrush" Value="#C5C9CC"/>
      <Setter Property="BorderThickness" Value="0.5"/>
      <Setter Property="BoxShadow" Value="inset 0 1 1 0 #3C4347"/>
    </Style>
  </UserControl.Styles>

  <Panel>
    <Panel.Background>
      <ImageBrush Source="avares://MessengerDesktop/Assets/brushed-metal.png" Stretch="Fill"/>
    </Panel.Background>

    <DockPanel>
      <Grid DockPanel.Dock="Top" Height="52" ColumnDefinitions="*,Auto,*" PointerPressed="OnDragAreaPressed">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Classes="vent"/>
            <Border Classes="vent"/>
            <Border Classes="vent"/>
          </StackPanel>
          <TextBlock Text="MESSENGER" Classes="engraved" FontSize="12" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border Classes="vent"/>
            <Border Classes="vent"/>
            <Border Classes="vent"/>
          </StackPanel>
        </StackPanel>
      </Grid>

      <Border Classes="sheet" Width="400" MaxWidth="440" Padding="28,26,28,18"
              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <StackPanel Spacing="0">
          <local:Glyph Data="{StaticResource IcBubble}" Width="28" Height="28" StrokeWidth="1.7"
                       Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="С возвращением" FontSize="26" FontWeight="Bold" LetterSpacing="-0.4"
                     HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock Text="Войдите, чтобы продолжить общение" Classes="secondary" FontSize="14"
                     HorizontalAlignment="Center" Margin="0,6,0,18"/>

          <TextBlock Classes="field" Text="Логин"/>
          <TextBox Classes="loginField" Text="{Binding Login}" Watermark="Введите логин" Margin="0,4,0,12"/>

          <TextBlock Classes="field" Text="Пароль"/>
          <TextBox x:Name="PasswordBox" Classes="loginField" Margin="0,4,0,0"
                   Text="{Binding Password}" PasswordChar="•" Watermark="Введите пароль">
            <TextBox.InnerRightContent>
              <Button Classes="eye" Width="32" Height="32" Margin="0,0,4,0"
                      AutomationProperties.Name="Показать пароль"
                      Click="OnTogglePassword">
                <Panel>
                  <local:Glyph x:Name="EyeOpen" Data="{StaticResource IcEye}" Width="16" Height="16"
                               Foreground="{DynamicResource LabelBrush}"/>
                  <local:Glyph x:Name="EyeClosed" Data="{StaticResource IcEyeOff}" Width="16" Height="16"
                               Foreground="{DynamicResource LabelBrush}" IsVisible="False"/>
                </Panel>
              </Button>
            </TextBox.InnerRightContent>
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>

          <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                     FontSize="13" Margin="0,8,0,0"
                     IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>

          <Button Classes="loginGo" Content="Войти" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                  Command="{Binding SignInCommand}"
                  IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0" Spacing="6">
            <TextBlock Text="Нет аккаунта?" Classes="secondary" FontSize="14" VerticalAlignment="Center"/>
            <Button Classes="link" Command="{Binding SignUpCommand}" Padding="0"
                    VerticalAlignment="Center"
                    IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
              <TextBlock Text="Создать аккаунт" FontSize="14"/>
            </Button>
          </StackPanel>

          <Border Height="1" Background="#D5D8DA" Margin="0,16,0,4"/>

          <Button Classes="disclosure" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                  Command="{Binding ToggleConnectionCommand}" Padding="0,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <local:Glyph Data="{StaticResource IcGear}" Width="16" Height="16"
                           Foreground="{DynamicResource LabelBrush}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="Настройки подключения" Margin="8,0,0,0"
                         VerticalAlignment="Center" FontSize="14"/>
              <Panel Grid.Column="2" VerticalAlignment="Center">
                <local:Glyph Data="{StaticResource IcChevronRight}" Width="14" Height="14"
                             Foreground="{DynamicResource LabelBrush}"
                             IsVisible="{Binding !ShowConnection}"/>
                <local:Glyph Data="{StaticResource IcChevronUp}" Width="14" Height="14"
                             Foreground="{DynamicResource LabelBrush}"
                             IsVisible="{Binding ShowConnection}"/>
              </Panel>
            </Grid>
          </Button>

          <StackPanel Spacing="4" Margin="0,4,0,6" IsVisible="{Binding ShowConnection}">
            <TextBlock Classes="field" Text="Сервер"/>
            <TextBox Classes="loginField" Text="{Binding Server}" Watermark="https://…/messenger"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Регистрация создаёт аккаунт и сразу входит. Сессия сохранится на этом компьютере."/>
          </StackPanel>
        </StackPanel>
      </Border>
    </DockPanel>

    <Panel IsHitTestVisible="False">
      <Border x:Name="ScrewTL" Classes="cornerScrew" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12,0,0">
        <Border Width="6" Height="1" CornerRadius="0.5" Background="#2C3236" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Border Classes="cornerScrew" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0">
        <Border Width="6" Height="1" CornerRadius="0.5" Background="#2C3236" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Border Classes="cornerScrew" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,12">
        <Border Width="6" Height="1" CornerRadius="0.5" Background="#2C3236" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <Border Classes="cornerScrew" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,14,12">
        <Border Width="6" Height="1" CornerRadius="0.5" Background="#2C3236" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
    </Panel>
  </Panel>
</UserControl>
