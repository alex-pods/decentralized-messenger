<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:MessengerDesktop"
             x:Class="MessengerDesktop.Views.LoginView"
             Background="Transparent"
             PointerPressed="OnDragAreaPressed">
  <Grid x:Name="LoginGrid" Classes="login" Margin="{DynamicResource LoginMargin}" ColumnDefinitions="*,340">
    <StackPanel VerticalAlignment="Top" Margin="0,28,36,0">
      <TextBlock Classes="engraved" Text="01"/>
      <TextBlock Text="С возвращением" Classes="display" Margin="0,10,0,0"/>
      <TextBlock Text="Войдите, чтобы продолжить общение" Classes="secondary" TextWrapping="Wrap" Margin="0,12,0,0"/>
    </StackPanel>

    <StackPanel x:Name="LoginForm" Classes="form" Grid.Column="1" Spacing="12">
      <StackPanel Classes="vents" Orientation="Horizontal" Spacing="3" IsHitTestVisible="False" Margin="4,0,0,2">
        <Border Classes="vent"/>
        <Border Classes="vent"/>
        <Border Classes="vent"/>
        <Border Classes="vent"/>
      </StackPanel>

      <StackPanel Classes="keys">
        <Button Classes="dial" Command="{Binding SignInCommand}"
                AutomationProperties.Name="Войти"
                IsEnabled="{Binding Busy, Converter={StaticResource Not}}">
          <StackPanel Spacing="4" HorizontalAlignment="Center">
            <local:Glyph Data="{StaticResource IcBubble}" Width="22" Height="22" StrokeWidth="1.8"
                         Foreground="{DynamicResource InkBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Войти" Classes="engraved" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
        <StackPanel Spacing="8" VerticalAlignment="Center">
          <TextBlock Text="или" Classes="engraved" HorizontalAlignment="Center"/>
          <Button Classes="large" Content="Создать аккаунт" Command="{Binding SignUpCommand}"
                  IsEnabled="{Binding Busy, Converter={StaticResource Not}}"/>
        </StackPanel>
      </StackPanel>

      <Border Classes="glass" Padding="12" Margin="0,6,0,0">
        <StackPanel Spacing="8">
          <TextBlock Classes="field" Text="Сервер"/>
          <TextBox Text="{Binding Server}" Watermark="https://…/messenger"/>
          <TextBlock Classes="field" Text="Логин" Margin="0,4,0,0"/>
          <TextBox Text="{Binding Login}" Watermark="3–16 символов"/>
          <TextBlock Classes="field" Text="Пароль" Margin="0,4,0,0"/>
          <TextBox Text="{Binding Password}" PasswordChar="•" Watermark="минимум 8 символов">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}"/>
            </TextBox.KeyBindings>
          </TextBox>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                 FontSize="13" Margin="2,0,2,0"
                 IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
      <TextBlock Classes="caption" TextWrapping="Wrap" Margin="2,4,2,0"
                 Text="Регистрация создаёт аккаунт и сразу входит. Сессия сохранится на этом компьютере."/>
    </StackPanel>
  </Grid>
</UserControl>
