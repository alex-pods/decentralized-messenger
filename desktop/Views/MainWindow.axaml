<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MessengerDesktop.Views.MainWindow"
        Title="Мессенджер"
        Width="1180" Height="780"
        MinWidth="360" MinHeight="560"
        Background="#B7BFC2"
        WindowStartupLocation="CenterScreen">
  <Panel x:Name="ChassisFrame" Margin="14">
    <Border x:Name="Housing" Classes="housing">
      <ContentControl Content="{Binding}"/>
    </Border>
    <Panel x:Name="ScrewLayer" IsHitTestVisible="False" Margin="{DynamicResource ScrewInset}">
      <Border Classes="screw" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      <Border Classes="screw" HorizontalAlignment="Right" VerticalAlignment="Top"/>
      <Border Classes="screw" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
      <Border Classes="screw" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Panel>
  </Panel>
</Window>
