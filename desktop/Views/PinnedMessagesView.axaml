<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop" x:Class="MessengerDesktop.Views.PinnedMessagesView" x:Name="Root">
  <Grid>
      <ScrollViewer Classes="dialogScroll" HorizontalScrollBarVisibility="Disabled" AllowAutoHide="False" ClipToBounds="True">
        <ItemsControl ItemsSource="{Binding PinList}" Margin="14" MaxWidth="628" HorizontalAlignment="Stretch">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,6">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="pinCard" Padding="11,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Cursor="Hand" ToolTip.Tip="Перейти к сообщению" AutomationProperties.Name="{Binding OpenLabel}"
                          Command="{Binding DataContext.OpenPinFromListCommand, ElementName=Root}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="*,Auto">
                      <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <local:Glyph Data="{StaticResource IcDevice}" Width="14" Height="14" IsVisible="{Binding Local}"/>
                          <local:Glyph Data="{StaticResource IcPin}" Width="14" Height="14" IsVisible="{Binding !Local}"/>
                          <TextBlock Text="{Binding Scope}" Classes="caption"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Text}" FontSize="14" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Attribution}" Classes="caption" TextWrapping="Wrap"/>
                      </StackPanel>
                      <local:Glyph Grid.Column="1" Data="{StaticResource IcChevronRight}" Width="16" Height="16"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="icon" Width="36" VerticalAlignment="Center" Margin="4,0,5,0"
                          ToolTip.Tip="Действия закрепа" AutomationProperties.Name="Действия закрепа" IsVisible="{Binding CanRemove}"
                          Click="OnPinActions">
                    <local:Glyph Data="{StaticResource IcMore}" Width="16" Height="16"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="22" MaxWidth="330" IsVisible="{Binding PinListEmpty}">
        <TextBlock Text="Закрепов пока нет" Classes="title" TextWrapping="Wrap"/>
      </StackPanel>
  </Grid>
</UserControl>
