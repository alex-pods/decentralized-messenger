<UserControl xmlns:views="using:MessengerDesktop.Views.Dialogs" xmlns:local="using:MessengerDesktop" xmlns:conv="using:Avalonia.Data.Converters" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MessengerDesktop.Views.ShellView" x:Name="Root" KeyDown="OnShellKeyDown">
  <Panel>
    <Grid x:Name="ShellGrid" Classes="shell" IsEnabled="{Binding !OverlayOpen}" ColumnDefinitions="300,*">
      <Border Classes="sidebar" Grid.Column="0" x:Name="ChatSidebar">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,12" Height="40">
            <TextBox x:Name="ChatSearch" Classes="search" TextChanged="OnChatFilterChanged" Watermark="Поиск чатов" AutomationProperties.Name="Поиск чатов">
              <TextBox.InnerLeftContent>
                <local:Glyph Data="{StaticResource IcSearch}" Width="16" Height="16" Margin="12,0,0,0" Foreground="{DynamicResource LabelBrush}"/>
              </TextBox.InnerLeftContent>
            </TextBox>
            <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0" Click="OnNewConversation" ToolTip.Tip="Начать разговор" AutomationProperties.Name="Начать разговор">
              <local:Glyph Data="{StaticResource IcCompose}"/>
            </Button>
          </Grid>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4">
            <Button Classes="account" Click="OnAccountMenu" HorizontalContentAlignment="Stretch" ToolTip.Tip="Аккаунт и настройки">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="avatar" Width="36" Height="36" Background="{Binding Header, Converter={StaticResource AvatarBrush}}">
                  <Panel>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                    <TextBlock Classes="avatarText" Text="{Binding DisplayName, Converter={StaticResource Initial}}" IsVisible="{Binding !HasAvatar}"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Status}" Classes="caption"/>
                </StackPanel>
                <local:Glyph Grid.Column="2" Data="{StaticResource IcSettings}" Width="18" Height="18" Foreground="{DynamicResource LabelBrush}"/>
              </Grid>
            </Button>
          </Border>
          <TextBlock x:Name="ChatEmpty" DockPanel.Dock="Bottom" IsVisible="False" Text="Чаты не найдены" Classes="secondary" Margin="24" TextWrapping="Wrap"/>
          <ListBox Classes="sidebar" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat, Mode=OneWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="ChatList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" MinHeight="48" ClipToBounds="True">
                  <Border Classes="avatar" Width="44" Height="44" ClipToBounds="True" Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
                    <Panel>
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                      <TextBlock Classes="avatarText" Text="{Binding Title, Converter={StaticResource Initial}}" IsVisible="{Binding ShowInitial}"/>
                      <local:Glyph Data="{StaticResource IcGroup}" Width="18" Height="18" StrokeWidth="1.8" Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
                    </Panel>
                  </Border>
                  <DockPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" LastChildFill="True">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Preview}" Classes="caption" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="unread" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Unread}"/>
                    </Grid>
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border x:Name="ScreenBay" Classes="screenbay deck" Grid.Column="1">
        <Grid RowDefinitions="Auto,*,Auto">
          <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,Auto,*,Auto" MinHeight="64" Margin="20,0" PointerPressed="OnDragAreaPressed">
            <Button x:Name="BackToChats" Classes="icon" Click="OnShowChats" IsVisible="False" ToolTip.Tip="К чатам">
              <local:Glyph Data="{StaticResource IcReply}"/>
            </Button>
            <Border Grid.Column="1" Classes="avatar" Width="32" Height="32" Margin="0,0,10,0" ClipToBounds="True" IsVisible="{Binding HasChat}" Background="{Binding SelectedChat.Id, Converter={StaticResource AvatarBrush}}">
              <Panel>
                <Image Source="{Binding SelectedChat.Avatar}" Stretch="UniformToFill" IsVisible="{Binding SelectedChat.HasAvatar}"/>
                <TextBlock Classes="avatarText" Text="{Binding SelectedChat.Title, Converter={StaticResource Initial}}" IsVisible="{Binding SelectedChat.ShowInitial}"/>
                <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16" StrokeWidth="1.8" Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
              </Panel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="{Binding ChatTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedChat.Kind}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasChat}"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Информация о чате" AutomationProperties.Name="Информация о чате" Command="{Binding ShowMembersCommand}" VerticalAlignment="Center" IsVisible="{Binding HasChat}">
              <local:Glyph Data="{StaticResource IcInfo}"/>
            </Button>
          </Grid></Border>
          <Border Grid.Row="1" Classes="screen" Margin="0" BorderThickness="0" CornerRadius="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Margin="24,0,24,10" Padding="8" CornerRadius="10" Background="{DynamicResource AccentFill}" IsVisible="{Binding HasPins}">
                <Grid ColumnDefinitions="*,Auto">
                  <Button Classes="toolbar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Command="{Binding ShowPinnedCommand}" Background="Transparent" BorderThickness="0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <local:Glyph Data="{StaticResource IcPin}" Width="14" Height="14" StrokeWidth="1.7" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Margin="8,0,8,0" Text="{Binding PinText}" Foreground="{DynamicResource OnFieldBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding PinCounter}" Classes="caption" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="1" Classes="icon small" ToolTip.Tip="Открепить" AutomationProperties.Name="Открепить" Command="{Binding UnpinShownCommand}" IsVisible="{Binding CanManagePins}">
                    <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                  </Button>
                </Grid>
              </Border>
              <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520" Margin="24" IsVisible="{Binding !HasChat}">
                  <TextBlock Text="С кем поговорим?" Classes="display" HorizontalAlignment="Center"/>
                  <TextBlock Text="Выберите чат слева или начните новый" Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="large" Command="{Binding ShowDirectCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Glyph Data="{StaticResource IcCompose}" Width="16" Height="16"/>
                        <TextBlock Text="Новый чат" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="large" Command="{Binding ShowGroupCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16"/>
                        <TextBlock Text="Группа" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <ListBox x:Name="Log" Classes="log" VerticalAlignment="Bottom" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Background="Transparent" Padding="0,16,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChat}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="24,3" HorizontalAlignment="Stretch" Classes="messageRow" ContextRequested="OnMessageContextRequested">
                        <Grid MaxWidth="768" HorizontalAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Mine}">
                            <Border Classes="avatar" Width="28" Height="28" VerticalAlignment="Top" Margin="0,6,8,0" IsVisible="{Binding DataContext.IsGroup, ElementName=Root}" Background="{Binding SenderId, Converter={StaticResource AvatarBrush}}">
                              <TextBlock Classes="avatarText" Text="{Binding SenderName, Converter={StaticResource Initial}}"/>
                            </Border>
                            <Border Grid.Column="1" Classes="bubble" HorizontalAlignment="Left" Padding="11,8" CornerRadius="8">
                              <StackPanel Spacing="4" MaxWidth="520">
                                <TextBlock Text="{Binding SenderName}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource OnFieldBrush}">
                                  <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                      <Binding Path="ShowSender"/>
                                      <Binding Path="DataContext.IsGroup" ElementName="Root"/>
                                    </MultiBinding>
                                  </TextBlock.IsVisible>
                                </TextBlock>
                                <TextBlock Text="{Binding Forwarded}" FontSize="13" FontStyle="Italic" Foreground="{DynamicResource OnFieldMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ForwardedTip}" IsVisible="{Binding IsForwarded}"/>
                                <Border Background="{DynamicResource ScreenInset}" CornerRadius="4" Padding="0,5,10,5" IsVisible="{Binding HasReply}">
                                  <Grid ColumnDefinitions="Auto,*">
                                    <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="8,0,8,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Reply}" FontSize="13" Foreground="{DynamicResource OnFieldMutedBrush}" MaxWidth="640" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                  </Grid>
                                </Border>
                                <TextBlock FontSize="15" LineHeight="21" MaxWidth="520" TextWrapping="Wrap" Foreground="{DynamicResource OnFieldBrush}" Classes.deleted="{Binding IsDeleted}"><Run Text="{Binding Text}"/><Run Text="  "/><Run Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource OnFieldMutedBrush}"/></TextBlock>
                                <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasReactions}" Margin="0,2,0,0">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <WrapPanel/>
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Border Classes="reaction" Classes.active="{Binding Mine}" Cursor="Hand" PointerPressed="OnChipPressed">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                          <local:ReactionIcon Emoji="{Binding Emoji}" Width="15" Height="15"/>
                                          <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource OnFieldBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>

                              </StackPanel>
                            </Border>
                          </Grid>
                          <Border Classes="bubble mine" HorizontalAlignment="Right" MaxWidth="540" MinWidth="56" IsVisible="{Binding Mine}" Padding="11,8" CornerRadius="8">
                            <StackPanel Spacing="4" MaxWidth="512">
                              <TextBlock Text="{Binding Forwarded}" FontSize="13" FontStyle="Italic" Foreground="{DynamicResource OnFieldMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ForwardedTip}" IsVisible="{Binding IsForwarded}"/>
                              <Border Background="{DynamicResource ScreenInset}" CornerRadius="4" Padding="0,5,10,5" IsVisible="{Binding HasReply}">
                                <Grid ColumnDefinitions="Auto,*">
                                  <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="8,0,8,0"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Reply}" FontSize="13" Foreground="{DynamicResource OnFieldMutedBrush}" MaxWidth="480" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                              </Border>
                              <TextBlock FontSize="15" LineHeight="21" MaxWidth="512" TextWrapping="Wrap" Foreground="{DynamicResource OnFieldBrush}" Classes.deleted="{Binding IsDeleted}"><Run Text="{Binding Text}"/><Run Text="  "/><Run Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource OnFieldMutedBrush}"/></TextBlock>
                              <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasReactions}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Classes="reaction" Classes.active="{Binding Mine}" Cursor="Hand" PointerPressed="OnChipPressed">
                                      <StackPanel Orientation="Horizontal" Spacing="5">
                                        <local:ReactionIcon Emoji="{Binding Emoji}" Width="15" Height="15"/>
                                        <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource OnFieldBrush}" VerticalAlignment="Center"/>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>

                            </StackPanel>
                          </Border>
                        </Grid>
                        <Button Classes="messageMenu icon" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,0,0" Click="OnMessageMenuClick" ToolTip.Tip="Действия с сообщением" AutomationProperties.Name="Действия с сообщением">
                          <local:Glyph Data="{StaticResource IcMore}"/>
                        </Button>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Classes="small" Command="{Binding LoadOlderCommand}" IsVisible="{Binding HasMore}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcChevronUp}" Width="12" Height="12" StrokeWidth="2"/>
                    <TextBlock Text="Показать раньше"/>
                  </StackPanel>
                </Button>
              </Panel>
            </DockPanel>
          </Border>
          <StackPanel Grid.Row="2" Background="{DynamicResource RaisedBrush}" Margin="0" Spacing="0" HorizontalAlignment="Stretch" IsVisible="{Binding HasChat}">
            <Border Classes="glass" Padding="12,8" IsVisible="{Binding HasComposeHint}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ComposeHint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Classes="icon small" Margin="8,0,0,0" AutomationProperties.Name="Отменить" Command="{Binding CancelComposeCommand}">
                  <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </Border>
            <Border Classes="composer">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="ComposerInput" Classes="bare" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" Watermark="Напишите сообщение…">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
                    <KeyBinding Gesture="Meta+Enter" Command="{Binding SendCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="send" VerticalAlignment="Bottom" Margin="6,0,2,0" ToolTip.Tip="Отправить · Ctrl+Enter / ⌘Enter" AutomationProperties.Name="Отправить" Command="{Binding SendCommand}" IsEnabled="{Binding !Busy}">
                  <local:Glyph Data="{StaticResource IcSend}" Width="18" Height="18" StrokeWidth="2.2" Foreground="{DynamicResource ActionTextBrush}"/>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <Border Classes="scrim" Background="{DynamicResource DimBrush}" IsVisible="{Binding OverlayOpen}">
      <Border Classes="sheet" MaxHeight="680" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="480" Margin="20" KeyboardNavigation.TabNavigation="Cycle" x:Name="OverlaySheet">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
              <StackPanel Spacing="2" VerticalAlignment="Center">

                <TextBlock Text="{Binding OverlayTitle}" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть" Command="{Binding CloseOverlayCommand}">
                <local:Glyph Data="{StaticResource IcClose}" Width="14" Height="14"/>
              </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <Button Classes="primary large" Content="Создать группу" HorizontalAlignment="Right" Padding="22,0" Command="{Binding CreateGroupCommand}" DockPanel.Dock="Bottom" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=group}" Margin="0,20,0,0" MinHeight="42"/>
            <ContentControl DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=profile}">
              <views:ProfileEditor/>
            </ContentControl>
            <views:GroupDetails DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=group}"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}">
              <Button Content="Скрыть чат у себя" Command="{Binding HideChatCommand}"/>
              <Button Classes="danger" Content="Выйти из группы" Click="OnLeaveGroup" IsVisible="{Binding IsGroup}"/>
            </StackPanel>
            <views:ForwardPicker DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=forward}"/>
            <DockPanel IsVisible="{Binding ShowPeopleSearch}">
              <views:PeopleSearch DockPanel.Dock="Top"/>
              <views:MemberList IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}"/>
            </DockPanel>
          </DockPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <Border Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="520">
      <Border.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="Error" Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}"/><Binding Path="!OverlayOpen"/></MultiBinding></Border.IsVisible>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="icon small" Margin="10,0,0,0" AutomationProperties.Name="Закрыть ошибку" Command="{Binding DismissErrorCommand}">
          <local:Glyph Data="{StaticResource IcClose}" Width="10" Height="10"/>
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
