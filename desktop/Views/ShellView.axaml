<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:MessengerDesktop"
             x:Class="MessengerDesktop.Views.ShellView"
             x:Name="Root">
  <UserControl.Resources>
    <StreamGeometry x:Key="IcSmilePlus">M22 11v1a10 10 0 1 1-9-10 M8 14s1.5 2 4 2 4-2 4-2 M8 9a.5.5 0 1 0 1 0a.5.5 0 1 0-1 0Z M15 9a.5.5 0 1 0 1 0a.5.5 0 1 0-1 0Z M16 5h6 M19 2v6</StreamGeometry>
  </UserControl.Resources>
  <Panel>
    <Grid x:Name="ShellGrid" Classes="shell" ColumnDefinitions="288,*">

      <!-- Отсек 01: список чатов -->
      <Border Classes="sidebar">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Height="52" Margin="16,0,10,0"
                PointerPressed="OnDragAreaPressed">
            <StackPanel VerticalAlignment="Center" Spacing="2" Margin="{DynamicResource HeaderInset}">
              <TextBlock Classes="engraved" Text="01"/>
              <TextBlock Classes="engraved" Text="Чаты"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        Margin="{DynamicResource ChromeLeading}">
              <StackPanel Orientation="Horizontal" Spacing="3" IsHitTestVisible="False" VerticalAlignment="Center" Margin="0,0,4,0">
                <Border Classes="vent"/>
                <Border Classes="vent"/>
                <Border Classes="vent"/>
              </StackPanel>
              <Button Classes="icon" ToolTip.Tip="Новый личный чат" AutomationProperties.Name="Новый личный чат"
                      Command="{Binding ShowDirectCommand}">
                <local:Glyph Data="{StaticResource IcCompose}"/>
              </Button>
              <Button Classes="icon" ToolTip.Tip="Новая группа" AutomationProperties.Name="Новая группа"
                      Command="{Binding ShowGroupCommand}">
                <local:Glyph Data="{StaticResource IcGroup}"/>
              </Button>
            </StackPanel>
          </Grid>

          <Button DockPanel.Dock="Bottom" Classes="row" Margin="8,6,8,10" Padding="8,7"
                  Command="{Binding ShowProfileCommand}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Panel>
                <Border Classes="avatar" Width="32" Height="32" ClipToBounds="True"
                        Background="{Binding Header, Converter={StaticResource AvatarBrush}}">
                  <Panel>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                    <TextBlock Classes="avatarText" Text="{Binding Header, Converter={StaticResource Initial}}"
                               IsVisible="{Binding !HasAvatar}"/>
                  </Panel>
                </Border>
                <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource OnlineBrush}"
                        BorderBrush="{DynamicResource RaisedBrush}" BorderThickness="2"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        IsVisible="{Binding Status, Converter={StaticResource Eq}, ConverterParameter=онлайн}"/>
              </Panel>
              <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center" Spacing="1">
                <TextBlock Text="{Binding Header}" FontWeight="Medium" FontSize="15" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Status}" Classes="caption"/>
              </StackPanel>
              <Button Grid.Column="2" Classes="icon small" ToolTip.Tip="Выйти" AutomationProperties.Name="Выйти"
                      Command="{Binding LogoutCommand}">
                <local:Glyph Data="{StaticResource IcLogout}" Width="16" Height="16"/>
              </Button>
            </Grid>
          </Button>

          <ListBox Classes="sidebar" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" MinHeight="36" ClipToBounds="True">
                  <Border Classes="avatar" Width="36" Height="36" ClipToBounds="True"
                          Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
                    <Panel>
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                      <TextBlock Classes="avatarText" Text="{Binding Title, Converter={StaticResource Initial}}"
                                 IsVisible="{Binding ShowInitial}"/>
                      <local:Glyph Data="{StaticResource IcGroup}" Width="18" Height="18" StrokeWidth="1.8"
                                   Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
                    </Panel>
                  </Border>
                  <DockPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" LastChildFill="True">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,1">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium"
                                 TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Preview}" Classes="caption"
                                 TextTrimming="CharacterEllipsis" MaxLines="1"
                                 TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="unread" Margin="8,0,0,0"
                              VerticalAlignment="Center" IsVisible="{Binding Unread}"/>
                    </Grid>
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <!-- Отсек 02: переписка -->
      <Border x:Name="ScreenBay" Classes="screenbay deck" Grid.Column="1">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="52" Margin="16,0,12,0" PointerPressed="OnDragAreaPressed">
            <Border Classes="avatar" Width="32" Height="32" Margin="0,0,10,0"
                    ClipToBounds="True"
                    IsVisible="{Binding HasChat}"
                    Background="{Binding SelectedChat.Id, Converter={StaticResource AvatarBrush}}">
              <Panel>
                <Image Source="{Binding SelectedChat.Avatar}" Stretch="UniformToFill"
                       IsVisible="{Binding SelectedChat.HasAvatar}"/>
                <TextBlock Classes="avatarText"
                           Text="{Binding SelectedChat.Title, Converter={StaticResource Initial}}"
                           IsVisible="{Binding SelectedChat.ShowInitial}"/>
                <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16" StrokeWidth="1.8"
                             Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
              </Panel>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
              <TextBlock Classes="engraved" Text="02"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{Binding ChatTitle}" Classes="title" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedChat.Kind}" Classes="caption" VerticalAlignment="Center"
                           IsVisible="{Binding HasChat}"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="2" Classes="icon" ToolTip.Tip="Участники" AutomationProperties.Name="Участники"
                    Command="{Binding ShowMembersCommand}" VerticalAlignment="Center"
                    IsVisible="{Binding HasChat}">
              <local:Glyph Data="{StaticResource IcInfo}"/>
            </Button>
          </Grid>

          <Border Grid.Row="1" Classes="screen" Margin="12,0,12,8">
            <Panel>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                          MaxWidth="520" Margin="24"
                          IsVisible="{Binding !HasChat}">
                <TextBlock Text="С кем поговорим?" Classes="display" HorizontalAlignment="Center"/>
                <TextBlock Text="Выберите чат слева или начните новый"
                           Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,14,0,0">
                  <Button Classes="large" Command="{Binding ShowDirectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <local:Glyph Data="{StaticResource IcCompose}" Width="16" Height="16"/>
                      <TextBlock Text="Новый чат" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                  <Button Classes="large" Command="{Binding ShowGroupCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16"/>
                      <TextBlock Text="Группа" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

              <ListBox x:Name="Log" Classes="log" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}"
                       Background="Transparent"
                       Padding="8,12,8,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       IsVisible="{Binding HasChat}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <!-- Строка растянута на всю ширину, MaxWidth стоит на тексте: иначе при Align=Right
                         Avalonia измеряет пузырь «в ноль» и ломает перенос. -->
                    <Grid Margin="16,4" HorizontalAlignment="Stretch">
                      <Grid MaxWidth="768" HorizontalAlignment="Stretch">

                        <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding !Mine}">
                          <Border Classes="avatar" Width="28" Height="28" VerticalAlignment="Top"
                                  Margin="0,6,10,0"
                                  Background="{Binding SenderId, Converter={StaticResource AvatarBrush}}">
                            <TextBlock Classes="avatarText"
                                       Text="{Binding SenderName, Converter={StaticResource Initial}}"/>
                          </Border>
                          <Border Grid.Column="1" Classes="bubble" HorizontalAlignment="Left" Padding="12,8">
                            <StackPanel Spacing="4" MaxWidth="680">
                              <TextBlock Text="{Binding SenderName}" FontSize="13" FontWeight="Bold"
                                         Foreground="{DynamicResource OnFieldBrush}">
                                <TextBlock.IsVisible>
                                  <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="ShowSender"/>
                                    <Binding Path="DataContext.IsGroup" ElementName="Root"/>
                                  </MultiBinding>
                                </TextBlock.IsVisible>
                              </TextBlock>
                              <Border Background="{DynamicResource ScreenInset}" CornerRadius="4" Padding="0,5,10,5"
                                      IsVisible="{Binding HasReply}">
                                <Grid ColumnDefinitions="Auto,*">
                                  <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="8,0,8,0"/>
                                  <TextBlock Grid.Column="1" Text="{Binding Reply}" FontSize="13"
                                             Foreground="{DynamicResource OnFieldMutedBrush}"
                                             MaxWidth="640" TextWrapping="Wrap" MaxLines="2"
                                             TextTrimming="CharacterEllipsis"/>
                                </Grid>
                              </Border>
                              <TextBlock Text="{Binding Text}" FontSize="16" LineHeight="22"
                                         MaxWidth="680" TextWrapping="Wrap"
                                         Foreground="{DynamicResource OnFieldBrush}" Classes.deleted="{Binding IsDeleted}"/>
                              <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasReactions}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Classes="reaction" Classes.active="{Binding Mine}" Cursor="Hand" PointerPressed="OnChipPressed">
                                      <StackPanel Orientation="Horizontal" Spacing="5">
                                        <local:ReactionIcon Emoji="{Binding Emoji}" Width="15" Height="15"/>
                                        <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource OnFieldBrush}" VerticalAlignment="Center"/>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <TextBlock Text="{Binding Meta}" Classes="caption"/>
                            </StackPanel>
                          </Border>
                        </Grid>

                        <Border Classes="bubble mine" HorizontalAlignment="Right" MaxWidth="540" MinWidth="56"
                                IsVisible="{Binding Mine}">
                          <StackPanel Spacing="4" MaxWidth="512">
                            <Border Background="{DynamicResource ScreenInset}" CornerRadius="4" Padding="0,5,10,5"
                                    IsVisible="{Binding HasReply}">
                              <Grid ColumnDefinitions="Auto,*">
                                <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="8,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Reply}" FontSize="13"
                                           Foreground="{DynamicResource OnFieldMutedBrush}"
                                           MaxWidth="480" TextWrapping="Wrap" MaxLines="2"
                                           TextTrimming="CharacterEllipsis"/>
                              </Grid>
                            </Border>
                            <TextBlock Text="{Binding Text}" FontSize="16" LineHeight="22"
                                       MaxWidth="512" TextWrapping="Wrap"
                                       Foreground="{DynamicResource OnFieldBrush}" Classes.deleted="{Binding IsDeleted}"/>
                            <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasReactions}" Margin="0,2,0,0">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <WrapPanel/>
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border Classes="reaction" Classes.active="{Binding Mine}" Cursor="Hand" PointerPressed="OnChipPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                      <local:ReactionIcon Emoji="{Binding Emoji}" Width="15" Height="15"/>
                                      <TextBlock Text="{Binding Count}" FontSize="12" Foreground="{DynamicResource OnFieldBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Meta}" Classes="caption" HorizontalAlignment="Right"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <Button HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Classes="small"
                      Command="{Binding LoadOlderCommand}" IsVisible="{Binding HasMore}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <local:Glyph Data="{StaticResource IcChevronUp}" Width="12" Height="12" StrokeWidth="2"/>
                  <TextBlock Text="Показать раньше"/>
                </StackPanel>
              </Button>
            </Panel>
          </Border>

          <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center" Margin="12,0,12,0"
                      IsVisible="{Binding HasMessageActions}">
            <Border Classes="capsule" HorizontalAlignment="Center" IsVisible="{Binding ShowMoreReactions}">
              <ItemsControl ItemsSource="{Binding MoreReactions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="toolbar"
                            Command="{Binding DataContext.ToggleReactionCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <local:ReactionIcon Emoji="{Binding}" Width="18" Height="18"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>

            <Border Classes="capsule" HorizontalAlignment="Stretch" Margin="8,0">
              <WrapPanel Orientation="Horizontal">
                <ItemsControl ItemsSource="{Binding QuickReactions}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="toolbar"
                              Command="{Binding DataContext.ToggleReactionCommand, ElementName=Root}"
                              CommandParameter="{Binding}">
                        <local:ReactionIcon Emoji="{Binding}" Width="18" Height="18"/>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="toolbar" ToolTip.Tip="Ещё реакции" AutomationProperties.Name="Ещё реакции"
                        Command="{Binding ToggleMoreReactionsCommand}">
                  <local:Glyph Data="{StaticResource IcSmilePlus}" Width="16" Height="16"/>
                </Button>
                <Border Width="1" Margin="4,8" Background="{DynamicResource LineBrush}"/>
                <Button Classes="toolbar" Command="{Binding ReplyCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcReply}" Width="14" Height="14"/>
                    <TextBlock Text="Ответить"/>
                  </StackPanel>
                </Button>
                <Button Classes="toolbar" Command="{Binding BeginEditCommand}" IsVisible="{Binding CanEdit}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcEdit}" Width="14" Height="14"/>
                    <TextBlock Text="Изменить"/>
                  </StackPanel>
                </Button>
                <Button Classes="toolbar" Command="{Binding DeleteForMeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcTrash}" Width="14" Height="14"/>
                    <TextBlock Text="Удалить у себя"/>
                  </StackPanel>
                </Button>
                <Button Classes="toolbar danger" Command="{Binding DeleteForEveryoneCommand}"
                        IsVisible="{Binding CanDeleteEveryone}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcTrash}" Width="14" Height="14"/>
                    <TextBlock Text="Удалить у всех"/>
                  </StackPanel>
                </Button>
              </WrapPanel>
            </Border>
          </StackPanel>

          <StackPanel Grid.Row="3" Margin="16,8,16,14" Spacing="8" MaxWidth="768" HorizontalAlignment="Stretch"
                      IsVisible="{Binding HasChat}">
            <Border Classes="glass" Padding="12,8" IsVisible="{Binding HasComposeHint}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ComposeHint}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Classes="icon small" Margin="8,0,0,0"
                        AutomationProperties.Name="Отменить"
                        Command="{Binding CancelComposeCommand}">
                  <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </Border>
            <Border Classes="composer">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Classes="bare" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200"
                         Watermark="Напишите сообщение…">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SendCommand}"/>
                    <KeyBinding Gesture="Meta+Enter" Command="{Binding SendCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="send" VerticalAlignment="Bottom" Margin="6,0,2,2"
                        ToolTip.Tip="Отправить (⌘↩)" AutomationProperties.Name="Отправить"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding !Busy}">
                  <local:Glyph Data="{StaticResource IcSend}" Width="18" Height="18" StrokeWidth="2.2"
                               Foreground="{DynamicResource InkBrush}"/>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Classes="scrim" Background="{DynamicResource DimBrush}" IsVisible="{Binding OverlayOpen}">
      <Border Classes="sheet" Width="460" MaxHeight="640" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
            <StackPanel Spacing="2" VerticalAlignment="Center">
              <TextBlock Classes="engraved" Text="03"/>
              <TextBlock Text="{Binding OverlayTitle}" FontSize="22" FontWeight="Bold" LetterSpacing="-0.4"/>
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть"
                    Command="{Binding CloseOverlayCommand}">
              <local:Glyph Data="{StaticResource IcClose}" Width="14" Height="14"/>
            </Button>
          </Grid>

          <StackPanel DockPanel.Dock="Top" Spacing="6"
                      IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=profile}">
            <StackPanel HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,8">
              <Border Width="112" Height="112" CornerRadius="4" Background="{Binding Header, Converter={StaticResource AvatarBrush}}"
                      ClipToBounds="True" DragDrop.AllowDrop="True" DragDrop.DragOver="OnAvatarDragOver"
                      DragDrop.Drop="OnAvatarDrop" BorderBrush="{DynamicResource WellEdge}" BorderThickness="1">
                <Grid>
                  <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                  <TextBlock Text="Перетащите картинку" TextWrapping="Wrap" TextAlignment="Center" FontSize="13"
                             Foreground="{DynamicResource OnFieldBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14"
                             IsVisible="{Binding !HasAvatar}"/>
                </Grid>
              </Border>
              <Button Classes="small" Content="Выбрать изображение…" Click="OnChooseAvatarClick" HorizontalAlignment="Center"/>
            </StackPanel>
            <TextBlock Classes="field" Text="Имя"/>
            <TextBox Text="{Binding DisplayName}"/>
            <TextBlock Classes="field" Text="О себе" Margin="0,8,0,0"/>
            <TextBox Text="{Binding Bio}" AcceptsReturn="True" MinHeight="80" TextWrapping="Wrap"
                     VerticalContentAlignment="Top"/>
            <CheckBox Content="Находить меня по тегу" IsChecked="{Binding AllowTagSearch}" Margin="0,8,0,0"/>
            <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,8,0,0"
                       Text="Сообщения всегда сохраняются на сервере."/>
            <Button Classes="primary large" Content="Сохранить" HorizontalAlignment="Right" Padding="26,0"
                    Margin="0,14,0,0" Command="{Binding SaveProfileCommand}"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,12"
                      IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=group}">
            <TextBlock Classes="field" Text="Название"/>
            <TextBox Text="{Binding GroupTitle}" Watermark="1–64 символа"/>
            <ItemsControl ItemsSource="{Binding GroupDraft}" Margin="0,8,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Classes="chip" Margin="0,0,6,6">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                      <Button Classes="icon small"
                              Command="{Binding DataContext.RemoveDraftCommand, ElementName=Root}"
                              CommandParameter="{Binding}">
                        <local:Glyph Data="{StaticResource IcClose}" Width="10" Height="10"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="primary large" Content="Создать группу" HorizontalAlignment="Right" Padding="22,0"
                    Command="{Binding CreateGroupCommand}"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"
                      Margin="0,16,0,0"
                      IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}">
            <Button Content="Скрыть чат у себя" Command="{Binding HideChatCommand}"/>
            <Button Classes="danger" Content="Выйти из группы" Command="{Binding LeaveChatCommand}"
                    IsVisible="{Binding IsGroup}"/>
          </StackPanel>

          <DockPanel IsVisible="{Binding ShowPeopleSearch}">
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding SearchQuery}" Watermark="Полный тег">
                  <TextBox.InnerLeftContent>
                    <local:Glyph Data="{StaticResource IcSearch}" Width="15" Height="15" Margin="12,0,0,0"
                                 Foreground="{DynamicResource LabelBrush}"/>
                  </TextBox.InnerLeftContent>
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
                <Button Grid.Column="1" Classes="primary" Content="Найти" Margin="8,0,0,0" MinHeight="40"
                        Command="{Binding SearchCommand}"/>
              </Grid>
              <ListBox Classes="plain" ItemsSource="{Binding SearchResults}" MaxHeight="190">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="row"
                            Command="{Binding DataContext.PickUserCommand, ElementName=Root}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="Auto,*">
                        <Border Classes="avatar" Width="30" Height="30" ClipToBounds="True"
                                Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
                          <Panel>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                            <TextBlock Classes="avatarText"
                                       Text="{Binding Label, Converter={StaticResource Initial}}"
                                       IsVisible="{Binding !HasAvatar}"/>
                          </Panel>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>

            <ListBox Classes="plain" ItemsSource="{Binding Members}" MaxHeight="360"
                     IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,*" Margin="0,7">
                    <Border Classes="avatar" Width="34" Height="34" VerticalAlignment="Top"
                            ClipToBounds="True"
                            Background="{Binding Id, Converter={StaticResource AvatarBrush}}">
                      <Panel>
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                        <TextBlock Classes="avatarText"
                                   Text="{Binding Title, Converter={StaticResource Initial}}"
                                   IsVisible="{Binding !HasAvatar}"/>
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="6">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" VerticalAlignment="Center"/>
                        <Border Classes="badge">
                          <TextBlock Text="{Binding RoleLabel}"/>
                        </Border>
                      </StackPanel>
                      <WrapPanel>
                        <Button Margin="0,0,6,6" Classes="small danger" Content="Исключить" IsVisible="{Binding CanKick}"
                                Command="{Binding DataContext.KickCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        <Button Margin="0,0,6,6" Classes="small" Content="{Binding PromoteLabel}" IsVisible="{Binding CanPromote}"
                                Command="{Binding DataContext.ToggleAdminCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                        <Button Margin="0,0,6,6" Classes="small" Content="Сделать владельцем" IsVisible="{Binding CanTransfer}"
                                Command="{Binding DataContext.TransferCommand, ElementName=Root}" CommandParameter="{Binding}"/>
                      </WrapPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </DockPanel>
      </Border>
    </Border>

    <Border Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Margin="0,0,0,28" MaxWidth="520"
            IsVisible="{Binding Error, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DangerBrush}"
                Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="icon small" Margin="10,0,0,0" AutomationProperties.Name="Закрыть ошибку"
                Command="{Binding DismissErrorCommand}">
          <local:Glyph Data="{StaticResource IcClose}" Width="10" Height="10"/>
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
