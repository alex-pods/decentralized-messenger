<UserControl xmlns:views="using:MessengerDesktop.Views.Dialogs" xmlns:local="using:MessengerDesktop" xmlns:conv="using:Avalonia.Data.Converters" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MessengerDesktop.Views.ShellView" x:Name="Root" KeyDown="OnShellKeyDown">
  <Panel>
    <Grid x:Name="ShellGrid" Classes="shell" IsEnabled="{Binding !OverlayOpen}" ColumnDefinitions="344,*">
      <Border Classes="sidebar" Grid.Column="0" x:Name="ChatSidebar">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="24,26,24,18" Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Сообщения" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="icon" Click="OnNewConversation" ToolTip.Tip="Новый разговор" AutomationProperties.Name="Новый разговор"><local:Glyph Data="{StaticResource IcCompose}"/></Button>
            </Grid>
            <TextBox x:Name="ChatSearch" Classes="search" TextChanged="OnChatFilterChanged" Watermark="Поиск" AutomationProperties.Name="Поиск чатов">
              <TextBox.InnerLeftContent><local:Glyph Data="{StaticResource IcSearch}" Width="16" Height="16" Margin="12,0,0,0" Foreground="{DynamicResource LabelBrush}"/></TextBox.InnerLeftContent>
            </TextBox>
          </StackPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4">
            <Grid ColumnDefinitions="*,Auto" Margin="8,4">
            <Button Classes="account" Command="{Binding ShowProfileCommand}" HorizontalContentAlignment="Stretch" ToolTip.Tip="Мой профиль">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Classes="avatar" Width="36" Height="36" Background="{Binding CurrentUserId, Converter={StaticResource AvatarBrush}}">
                  <Panel>
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                    <TextBlock Classes="avatarText" Text="{Binding DisplayName, Converter={StaticResource Initial}}" IsVisible="{Binding !HasAvatar}"/>
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Status}" Classes="caption"/>
                </StackPanel>

              </Grid>
            </Button>
            <Button Grid.Column="1" Classes="icon" Click="OnAccountMenu" Margin="16,0,8,0" VerticalAlignment="Center" ToolTip.Tip="Настройки" AutomationProperties.Name="Настройки"><local:Glyph Data="{StaticResource IcSettings}"/></Button>
            </Grid>
          </Border>
          <TextBlock x:Name="ChatEmpty" DockPanel.Dock="Bottom" IsVisible="False" Text="Чаты не найдены" Classes="secondary" Margin="24" TextWrapping="Wrap"/>
          <ListBox Classes="sidebar" ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat, Mode=OneWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="ChatList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" MinHeight="52" ClipToBounds="True">
                  <Border Classes="avatar" Width="46" Height="46" ClipToBounds="True" Background="{Binding AvatarColorKey, Converter={StaticResource AvatarBrush}}">
                    <Panel>
                      <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}"/>
                      <TextBlock Classes="avatarText" Text="{Binding Title, Converter={StaticResource Initial}}" IsVisible="{Binding ShowInitial}"/>
                      <local:Glyph Data="{StaticResource IcGroup}" Width="18" Height="18" StrokeWidth="1.8" Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
                    </Panel>
                  </Border>
                  <DockPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" LastChildFill="True">
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                      <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="caption" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Text="{Binding Preview}" Classes="caption" TextTrimming="CharacterEllipsis" MaxLines="1" TextWrapping="NoWrap" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="unread" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding Unread}"/>
                    </Grid>
                  </DockPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <Border x:Name="ScreenBay" Classes="screenbay deck" Grid.Column="1">
        <Panel>
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding !ShowingPinnedMessages}">
          <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="Auto,Auto,*,Auto" MinHeight="84" Margin="28,0" PointerPressed="OnDragAreaPressed">
            <Button x:Name="BackToChats" Classes="icon" Click="OnShowChats" IsVisible="False" ToolTip.Tip="К чатам">
              <local:Glyph Data="{StaticResource IcReply}"/>
            </Button>
            <Border Grid.Column="1" Classes="avatar" Width="40" Height="40" Margin="0,0,12,0" ClipToBounds="True" IsVisible="{Binding HasChat}" Background="{Binding SelectedChat.AvatarColorKey, Converter={StaticResource AvatarBrush}}">
              <Panel>
                <Image Source="{Binding SelectedChat.Avatar}" Stretch="UniformToFill" IsVisible="{Binding SelectedChat.HasAvatar}"/>
                <TextBlock Classes="avatarText" Text="{Binding SelectedChat.Title, Converter={StaticResource Initial}}" IsVisible="{Binding SelectedChat.ShowInitial}"/>
                <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16" StrokeWidth="1.8" Foreground="{DynamicResource OnFieldBrush}" IsVisible="{Binding IsGroup}"/>
              </Panel>
            </Border>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
              <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="{Binding ChatTitle}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedChat.Kind}" Classes="caption" VerticalAlignment="Center" IsVisible="{Binding HasChat}"/>
              </StackPanel>
            </StackPanel>
            <Button Grid.Column="3" Classes="icon" ToolTip.Tip="Информация о чате" AutomationProperties.Name="Информация о чате" Command="{Binding ShowMembersCommand}" VerticalAlignment="Center" IsVisible="{Binding HasChat}">
              <local:Glyph Data="{StaticResource IcInfo}"/>
            </Button>
          </Grid></Border>
          <Border Grid.Row="1" Classes="screen" Margin="0" BorderThickness="0" CornerRadius="0">
            <DockPanel>
              <Border DockPanel.Dock="Top" Padding="12,3" BorderThickness="0,0,0,1"
                      BorderBrush="{DynamicResource SeparatorBrush}" IsVisible="{Binding HasPins}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Button x:Name="OpenPinnedMessages" Classes="icon small" Width="32" Height="32" VerticalAlignment="Center"
                          ToolTip.Tip="Все закреплённые сообщения" AutomationProperties.Name="Все закреплённые сообщения"
                          Command="{Binding ShowPinListCommand}">
                    <PathIcon Width="16" Height="16" Data="M 1,2 H 4 V 5 H 1 Z M 6,2 H 15 V 4 H 6 Z M 1,7 H 4 V 10 H 1 Z M 6,7 H 15 V 9 H 6 Z M 1,12 H 4 V 15 H 1 Z M 6,12 H 15 V 14 H 6 Z"/>
                  </Button>
                  <Button Grid.Column="1" Classes="toolbar" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          Command="{Binding ShowPinnedCommand}" Background="Transparent" BorderThickness="0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Border Width="2" CornerRadius="1" Background="{DynamicResource AccentBrush}"/>
                      <StackPanel Grid.Column="1" Margin="8,0" Spacing="1">
                        <TextBlock Text="{Binding PinScope}" Classes="caption" Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="{Binding PinText}" Foreground="{DynamicResource OnFieldBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding PinCounter}" Classes="caption" VerticalAlignment="Center"/>
                    </Grid>
                  </Button>
                  <Button Grid.Column="2" Classes="icon small" ToolTip.Tip="Открепить" AutomationProperties.Name="Открепить"
                          Command="{Binding UnpinShownCommand}" IsVisible="{Binding CanUnpinShown}">
                    <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                  </Button>
                </Grid>
              </Border>
              <Panel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" MaxWidth="520" Margin="24" IsVisible="{Binding !HasChat}">
                  <TextBlock Text="С кем поговорим?" Classes="display" HorizontalAlignment="Center"/>
                  <TextBlock Text="Выберите чат слева или начните новый" Classes="secondary" HorizontalAlignment="Center" TextAlignment="Center"/>
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Button Classes="large" Command="{Binding ShowDirectCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Glyph Data="{StaticResource IcCompose}" Width="16" Height="16"/>
                        <TextBlock Text="Новый чат" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Button Classes="large" Command="{Binding ShowGroupCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <local:Glyph Data="{StaticResource IcGroup}" Width="16" Height="16"/>
                        <TextBlock Text="Группа" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <ListBox x:Name="Log" Classes="log" VerticalAlignment="Bottom" ItemsSource="{Binding Messages}" SelectedItem="{Binding SelectedMessage}" Background="Transparent" Padding="0,16,0,12" ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasChat}">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid RowDefinitions="Auto,Auto" Classes="messageRow" Margin="24,0" ContextRequested="OnMessageContextRequested">
                        <Border IsVisible="{Binding StartsDay}" Background="{DynamicResource RaisedBrush}" CornerRadius="7" HorizontalAlignment="Center" Padding="12,4" Margin="0,16,0,18">
                          <TextBlock Text="{Binding DayLabel}" Classes="caption"/>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="{Binding Mine, Converter={StaticResource Align}}" MaxWidth="636" Margin="0,4"
                              Background="Transparent">
                          <Border Classes="avatar" Width="30" Height="30" VerticalAlignment="Bottom" Margin="0,0,8,2" Background="{Binding SenderId, Converter={StaticResource AvatarBrush}}">
                            <Border.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!Mine"/><Binding Path="DataContext.IsGroup" ElementName="Root"/></MultiBinding></Border.IsVisible>
                            <TextBlock Classes="avatarText" Text="{Binding SenderName, Converter={StaticResource Initial}}" FontSize="12"/>
                          </Border>
                          <Border Grid.Column="1" Classes="bubble" Classes.mine="{Binding Mine}" Padding="13,9" MinWidth="82">
                            <StackPanel Spacing="5" MaxWidth="526">
                              <TextBlock Text="{Binding SenderName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                <TextBlock.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="!Mine"/><Binding Path="StartsRun"/><Binding Path="DataContext.IsGroup" ElementName="Root"/></MultiBinding></TextBlock.IsVisible>
                              </TextBlock>
                              <TextBlock Text="{Binding Forwarded}" Classes="caption" TextWrapping="Wrap" ToolTip.Tip="{Binding ForwardedTip}" IsVisible="{Binding IsForwarded}"/>
                              <Border Background="{DynamicResource QuoteFill}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="9,6" IsVisible="{Binding HasReply}">
                                <TextBlock Text="{Binding Reply}" FontSize="13" Foreground="{DynamicResource LabelBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
                              </Border>
                              <local:MessageTextPanel>
                                <TextBlock Text="{Binding Text}" FontSize="15" LineHeight="21" TextWrapping="Wrap" Classes.deleted="{Binding IsDeleted}"/>
                                <TextBlock Text="{Binding Meta}" Classes="caption" FontSize="11" TextWrapping="Wrap"/>
                              </local:MessageTextPanel>
                              <ItemsControl ItemsSource="{Binding Chips}" IsVisible="{Binding HasReactions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                  <Border Classes="reaction" Classes.active="{Binding Mine}" Margin="0,0,5,0" Cursor="Hand" PointerPressed="OnChipPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="5"><local:ReactionIcon Emoji="{Binding Emoji}" Width="16" Height="16"/><TextBlock Text="{Binding Count}" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                                  </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                              </ItemsControl>

                            </StackPanel>
                          </Border>
                          <Button Grid.Column="2" Classes="messageMenu icon" VerticalAlignment="Center" Margin="6,0,0,0"
                                  Click="OnMessageMenuClick" ToolTip.Tip="Действия с сообщением" AutomationProperties.Name="Действия с сообщением">
                            <local:Glyph Data="{StaticResource IcMore}"/>
                          </Button>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" Classes="small" Command="{Binding LoadOlderCommand}" IsVisible="{Binding HasMore}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <local:Glyph Data="{StaticResource IcChevronUp}" Width="12" Height="12" StrokeWidth="2"/>
                    <TextBlock Text="Показать раньше"/>
                  </StackPanel>
                </Button>
              </Panel>
            </DockPanel>
          </Border>
          <StackPanel Grid.Row="2" Background="Transparent" Margin="24,12,24,20" Spacing="8" HorizontalAlignment="Stretch" IsVisible="{Binding HasChat}">
            <Border Classes="glass" Padding="12,8" IsVisible="{Binding HasComposeHint}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="3" Background="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" Text="{Binding ComposeHint}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="2" Classes="icon small" Margin="8,0,0,0" AutomationProperties.Name="Отменить" Command="{Binding CancelComposeCommand}">
                  <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                </Button>
              </Grid>
            </Border>
            <TextBlock Text="{Binding DraftLengthHint}" IsVisible="{Binding HasDraftLengthHint}" Classes="caption" HorizontalAlignment="Right"/>
            <Border Classes="composer">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="ComposerInput" Classes="bare" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" Watermark="Напишите сообщение…"/>
                <Button x:Name="SendButton" Grid.Column="1" Classes="send" VerticalAlignment="Bottom" Margin="6,0,2,0" AutomationProperties.Name="Отправить" Command="{Binding SendCommand}" IsEnabled="{Binding CanSendDraft}">
                  <local:Glyph Data="{StaticResource IcSend}" Width="18" Height="18" StrokeWidth="2.2" Foreground="{DynamicResource ActionTextBrush}"/>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </Grid>
        <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowingPinnedMessages}">
          <Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*" MinHeight="84" Margin="24,0">
              <Button x:Name="BackFromPinnedMessages" Classes="icon" Margin="0,0,12,0"
                      VerticalAlignment="Center" ToolTip.Tip="Назад в чат" AutomationProperties.Name="Назад в чат"
                      Command="{Binding ClosePinListCommand}">
                <PathIcon Width="18" Height="18" Data="M 8,2 L 9.5,3.5 L 4,9 H 17 V 11 H 4 L 9.5,16.5 L 8,18 L 0,10 Z"/>
              </Button>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="Закреплённые сообщения" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ChatTitle}" Classes="caption" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding PinList}" Margin="24,18">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="{Binding Mine, Converter={StaticResource Align}}" MaxWidth="600" Margin="0,0,0,9">
                      <Button Padding="0" Background="Transparent" BorderThickness="0"
                              HorizontalContentAlignment="Stretch"
                              ToolTip.Tip="Перейти к сообщению в чате"
                              Command="{Binding DataContext.OpenPinFromListCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <Border Classes="bubble" Classes.mine="{Binding Mine}" Padding="13,9">
                          <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="Auto,*">
                              <TextBlock Text="{Binding Sender}" FontSize="13" FontWeight="SemiBold"
                                         Foreground="{DynamicResource AccentBrush}" MaxWidth="120" Margin="0,0,8,0"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                         IsVisible="{Binding Sender, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                              <TextBlock Grid.Column="1" Text="{Binding Scope}" Classes="caption"
                                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <local:MessageTextPanel>
                              <TextBlock Text="{Binding Text}" FontSize="15" LineHeight="21" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Time}" Classes="caption" FontSize="11"
                                         IsVisible="{Binding Time, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"/>
                            </local:MessageTextPanel>
                          </StackPanel>
                        </Border>
                      </Button>
                      <Button Grid.Column="1" Classes="icon small" VerticalAlignment="Center" Margin="5,0,0,0"
                              ToolTip.Tip="Открепить сообщение" AutomationProperties.Name="Открепить сообщение"
                              IsVisible="{Binding CanRemove}"
                              Command="{Binding DataContext.RemovePinFromListCommand, ElementName=Root}" CommandParameter="{Binding}">
                        <local:Glyph Data="{StaticResource IcClose}" Width="12" Height="12"/>
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <TextBlock Text="В этом чате пока нет закреплённых сообщений." Classes="secondary"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                       TextAlignment="Center" TextWrapping="Wrap" IsVisible="{Binding PinListEmpty}"/>
          </Grid>
        </Grid>
        </Panel>
      </Border>
    </Grid>
    <Border Classes="scrim" Background="{DynamicResource DimBrush}" IsVisible="{Binding OverlayOpen}">
      <Border Classes="sheet" MaxHeight="680" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="480" Margin="20" KeyboardNavigation.TabNavigation="Cycle" x:Name="OverlaySheet">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,18">
              <StackPanel Spacing="2" VerticalAlignment="Center">

                <TextBlock Text="{Binding OverlayTitle}" FontSize="18" FontWeight="SemiBold"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="icon" ToolTip.Tip="Закрыть" AutomationProperties.Name="Закрыть" Command="{Binding CloseOverlayCommand}">
                <local:Glyph Data="{StaticResource IcClose}" Width="14" Height="14"/>
              </Button>
            </Grid>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            <Button Classes="primary large" Content="Создать группу" HorizontalAlignment="Right" Padding="22,0" Command="{Binding CreateGroupCommand}" DockPanel.Dock="Bottom" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=group}" Margin="0,20,0,0" MinHeight="42"/>
            <ContentControl DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=profile}">
              <views:ProfileEditor/>
            </ContentControl>
            <views:GroupDetails DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=group}"/>
            <WrapPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}">
              <Button Content="Скрыть чат у себя" Command="{Binding HideChatCommand}" Margin="0,0,8,8"/>
              <Button Classes="danger" Content="Выйти из группы" Click="OnLeaveGroup" IsVisible="{Binding IsGroup}" Margin="0,0,0,8"/>
            </WrapPanel>
            <views:ForwardPicker DockPanel.Dock="Top" IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=forward}"/>
            <DockPanel IsVisible="{Binding ShowPeopleSearch}">
              <views:PeopleSearch DockPanel.Dock="Top"/>
              <views:MemberList IsVisible="{Binding Overlay, Converter={StaticResource Eq}, ConverterParameter=members}"/>
            </DockPanel>
          </DockPanel>
        </ScrollViewer>
      </Border>
    </Border>
    <Border Classes="toast" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,28" MaxWidth="520">
      <Border.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="Error" Converter="{x:Static conv:StringConverters.IsNotNullOrEmpty}"/><Binding Path="!OverlayOpen"/></MultiBinding></Border.IsVisible>
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="icon small" Margin="10,0,0,0" AutomationProperties.Name="Закрыть ошибку" Command="{Binding DismissErrorCommand}">
          <local:Glyph Data="{StaticResource IcClose}" Width="10" Height="10"/>
        </Button>
      </Grid>
    </Border>
  </Panel>
</UserControl>
